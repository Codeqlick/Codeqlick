# Server-only: base URL of the Codeqlick API (never exposed to the browser)
API_URL=http://localhost:4000/v1
# Server-only: canonical public URL of this site (metadata, sitemap, robots)
SITE_URL=http://localhost:3000
# Public: the only variable allowed in the client bundle
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: the API as people reach it, shown in instructions (release keys, site forms)
# PUBLIC_API_URL=http://localhost:4000/v1
# Optional: Umami analytics (the site serves the tracker at /api/stats)
# UMAMI_URL=http://localhost:3020
# UMAMI_WEBSITE_ID=
# Optional: the legal pages (/legal, /privacy) render only with the owner's name
# LEGAL_OWNER_NAME=
# LEGAL_OWNER_TAX_ID=
# LEGAL_OWNER_ADDRESS=
