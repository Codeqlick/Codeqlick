{
  "name": "codeqlick-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Codeqlick website, client portal and admin panel (Next.js 16, BFF over the Codeqlick API)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
