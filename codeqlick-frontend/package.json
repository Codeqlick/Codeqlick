{
  "name": "codeqlick-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Codeqlick website, client portal and admin panel (Next.js 16, BFF over the Codeqlick API)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "leaflet": "1.9.4",
    "mdast-util-from-markdown": "2.1.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.22",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
