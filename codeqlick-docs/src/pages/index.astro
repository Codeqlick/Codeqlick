---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base
  description="Documentation of Codeqlick Cloud: static hosting, builds, domains, forms and more. Documentación de Codeqlick Cloud."
  alternates={[
    { hreflang: 'en', href: '/en/' },
    { hreflang: 'es', href: '/es/' },
    { hreflang: 'x-default', href: '/' },
  ]}
>
  <main class="picker">
    <Logo href="/" label="codeqlick Docs" />
    <h1 class="sr-only">Codeqlick Cloud docs</h1>
    <ul class="picker-list">
      <li>
        <a href="/en/" hreflang="en" lang="en">
          <span class="picker-name">English</span>
          <span class="picker-note">Read the documentation</span>
        </a>
      </li>
      <li>
        <a href="/es/" hreflang="es" lang="es">
          <span class="picker-name">Español</span>
          <span class="picker-note">Lee la documentación</span>
        </a>
      </li>
    </ul>
  </main>
  <script is:inline>
    // Send visitors to their language; crawlers and no-JavaScript visitors keep the two links.
    var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
    var es = first.toLowerCase().indexOf('es') === 0;
    location.replace(es ? '/es/' : '/en/');
  </script>
</Base>
