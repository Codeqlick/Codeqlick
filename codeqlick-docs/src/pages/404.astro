---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base
  title="Page not found / Página no encontrada"
  description="This page doesn't exist. Esta página no existe."
>
  <main class="picker">
    <Logo href="/" label="codeqlick Docs" />
    <h1>Page not found</h1>
    <p>
      This page doesn't exist. <a href="/en/">Go to the documentation</a>.
    </p>
    <h2 class="picker-h2" lang="es">
      Página no encontrada
    </h2>
    <p lang="es">
      Esta página no existe. <a href="/es/">Ir a la documentación</a>.
    </p>
  </main>
</Base>
