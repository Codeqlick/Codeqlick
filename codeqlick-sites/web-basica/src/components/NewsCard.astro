---
import { Image } from 'astro:assets';
import type { NewsPost } from '../types';
import { formatDate, photoOf, postPath } from '../lib/news';

interface Props {
  post: NewsPost;
  /** Heading level of the title: 2 inside the list page, 3 under a section's title. */
  level?: 2 | 3;
}

const { post, level = 3 } = Astro.props;
const photo = photoOf(post);
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="card">
  {photo ? (
    <a class="photo" href={postPath(post)} tabindex="-1" aria-hidden="true">
      <Image src={photo} alt="" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 33vw" />
    </a>
  ) : null}
  <div class="body">
    <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
    <Heading>
      <a href={postPath(post)}>{post.title}</a>
    </Heading>
    <p>{post.summary}</p>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: var(--radius);
    background: var(--background);
  }

  .photo {
    display: block;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .body {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem 1.4rem;
  }

  time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  h2,
  h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  h2 a,
  h3 a {
    text-decoration: none;
  }

  h2 a:hover,
  h3 a:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }

  p {
    margin: 0;
    color: var(--muted);
  }
</style>
