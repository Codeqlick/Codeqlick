---
import { addressLine, site, telHref } from '../lib/site';

const social = Object.entries(site.social ?? {}).filter(([, url]) => url) as Array<
  [string, string]
>;
const names: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  x: 'X',
};
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid">
    <div class="about">
      <p class="name">{site.business.name}</p>
      <p>{site.business.description}</p>
    </div>
    <div>
      <p class="title">Contacto</p>
      <ul>
        {site.contact.address ? <li>{addressLine(site.contact.address)}</li> : null}
        {site.contact.phone ? (
          <li>
            <a href={telHref(site.contact.phone)}>{site.contact.phone}</a>
          </li>
        ) : null}
        {site.contact.email ? (
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
        ) : null}
      </ul>
    </div>
    {social.length > 0 ? (
      <div>
        <p class="title">Síguenos</p>
        <ul>
          {social.map(([key, url]) => (
            <li>
              <a href={url} rel="noopener" target="_blank">
                {names[key] ?? key}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
  </div>
  <div class="container bottom">
    <p>
      © {year} {site.legal.owner}
    </p>
    <ul class="legal">
      <li>
        <a href="/aviso-legal">Aviso legal</a>
      </li>
      <li>
        <a href="/privacidad">Privacidad</a>
      </li>
      <li>
        <a href="/cookies">Cookies</a>
      </li>
    </ul>
    <p class="credit">
      Web creada por{' '}
      <a href="https://codeqlick.com/es" rel="noopener">
        Codeqlick
      </a>
    </p>
  </div>
  {site.footerNote ? <p class="container note">{site.footerNote}</p> : null}
</footer>

<style>
  .footer {
    padding-top: 4rem;
    background: var(--text);
    color: color-mix(in srgb, var(--background) 82%, transparent);
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .about {
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .name {
    color: var(--background);
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .title {
    margin-bottom: 0.75rem;
    color: var(--background);
    font-weight: 600;
  }

  ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--background);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--background) 15%, transparent);
    font-size: 0.875rem;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .credit {
    margin-left: auto;
  }

  .note {
    padding-bottom: 1.5rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .credit {
      margin-left: 0;
    }
  }
</style>
