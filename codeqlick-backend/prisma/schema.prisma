// Codeqlick data model. See docs/architecture.md section 4.2.
// The connection URL lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum Locale {
  EN
  ES
}

/// The sales process (wiki: Client Engagement): first contact, talking, discovery call, proposal,
/// then won or lost. SPAM is not a stage: it takes noise off the board.
enum LeadStatus {
  NEW
  TALKING
  CALL
  PROPOSAL
  WON
  LOST
  SPAM
}

enum LeadLostReason {
  PRICE
  NO_RESPONSE
  NOT_A_FIT
  CHOSE_OTHER
  TIMING
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

/// Where a release went: the preview (staging) or the live site.
enum ReleaseEnvironment {
  STAGING
  PRODUCTION
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  LAUNCHED
  SUPPORT
  ON_HOLD
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  /// Optional unique username (lower-cased, shown as @name); freed when changed or deleted.
  username           String?   @unique
  /// Profile photo (file name under UPLOADS_DIR/avatars); never shown in the 18+ apps.
  avatarKey          String?   @map("avatar_key")
  role               Role      @default(CLIENT)
  isActive           Boolean   @default(true) @map("is_active")
  /// Language of the emails the platform sends this user (welcome, project updates).
  locale             Locale    @default(EN)
  /// Two-step verification: the authenticator secret, encrypted (see secret-box.ts). Set while
  /// setting it up; it only counts once `totpEnabledAt` is set.
  totpSecret         String?   @map("totp_secret")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted time step, so a code can't be used twice.
  totpLastStep       Int?      @map("totp_last_step")
  /// SHA-256 of each unused recovery code.
  totpRecoveryHashes String[]  @default([]) @map("totp_recovery_hashes")
  /// Clients get a Monday summary of their projects unless they turn it off.
  weeklyDigest       Boolean   @default(true) @map("weekly_digest")
  /// When the last summary went out, so each client gets one per week even across restarts.
  lastDigestAt       DateTime? @map("last_digest_at") @db.Timestamptz(3)
  /// Clients with a managed website get its monthly report unless they turn it off.
  monthlyReport      Boolean   @default(true) @map("monthly_report")
  /// When the person made the account theirs (signed up, or accepted the invitation). Null: a
  /// client account the team prepared for an email, which nobody can sign in to yet (decision 17).
  registeredAt       DateTime? @default(now()) @map("registered_at") @db.Timestamptz(3)
  /// The Codeqlick web app the person signed up from (`videochat`, `swipe`, …; see webapps.ts).
  /// Null: signed up on codeqlick.com, or an account the team created (decision 29).
  signupApp          String?   @map("signup_app")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                   Session[]
  passwordResets             PasswordResetToken[]
  emailChanges               EmailChangeToken[]
  clientProjects             ClientProject[]
  posts                      Post[]
  projectUpdates             ProjectUpdate[]             @relation("ProjectUpdateAuthor")
  approvedUpdates            ProjectUpdate[]             @relation("ProjectUpdateApprover")
  updateComments             ProjectUpdateComment[]
  leadsConverted             Lead[]                      @relation("LeadClient")
  leadsAdded                 Lead[]                      @relation("LeadCreator")
  tickets                    SupportTicket[]
  ticketMessages             TicketMessage[]
  ticketFiles                TicketAttachment[]
  proposals                  Proposal[]                  @relation("ProposalClient")
  proposalsMade              Proposal[]                  @relation("ProposalAuthor")
  timeEntries                TimeEntry[]
  credentials                ProjectCredential[]
  siteRevisions              ManagedSiteRevision[]
  /// A person of a client company: they see and act on the account of `memberOf` (the company's
  /// main client account), which owns the projects, requests and proposals.
  memberOfId                 String?                     @map("member_of_id") @db.Uuid
  memberOf                   User?                       @relation("ClientTeam", fields: [memberOfId], references: [id], onDelete: Cascade)
  members                    User[]                      @relation("ClientTeam")
  projectFiles               ProjectFile[]
  invoicesUploaded           ProjectInvoice[]
  activity                   ActivityLog[]
  leadReplies                LeadReply[]
  videochatProfile           VideochatProfile?
  videochatReportsMade       VideochatReport[]           @relation("VideochatReporter")
  videochatReportsGot        VideochatReport[]           @relation("VideochatReported")
  videochatReviewed          VideochatReport[]           @relation("VideochatReviewer")
  videochatBlocksMade        VideochatBlock[]            @relation("VideochatBlocker")
  videochatBlocksGot         VideochatBlock[]            @relation("VideochatBlocked")
  videochatLikesGiven        VideochatLike[]             @relation("VideochatLiker")
  videochatLikesGot          VideochatLike[]             @relation("VideochatLiked")
  videochatActiveDays        VideochatActiveDay[]
  videochatSanctions         VideochatSanction[]         @relation("VideochatSanctioned")
  videochatSanctioned        VideochatSanction[]         @relation("VideochatSanctionedBy")
  videochatAppeals           VideochatAppeal[]           @relation("VideochatAppellant")
  videochatAppealsDone       VideochatAppeal[]           @relation("VideochatAppealReviewer")
  meetingRooms               MeetingRoom[]
  bookingPages               BookingPage[]
  appointments               Appointment[]
  videochatPushSubscriptions VideochatPushSubscription[]
  swipePushSubscriptions     SwipePushSubscription[]
  swipeProfile               SwipeProfile?
  swipePhotos                SwipePhoto[]                @relation("SwipePhotoOwner")
  swipePhotosReviewed        SwipePhoto[]                @relation("SwipePhotoReviewer")
  swipeVotes                 SwipeVote[]
  swipeMatchesA              SwipeMatch[]                @relation("SwipeMatchA")
  swipeMatchesB              SwipeMatch[]                @relation("SwipeMatchB")
  swipeMessages              SwipeMessage[]
  swipeReportsMade           SwipeReport[]               @relation("SwipeReporter")
  swipeReportsGot            SwipeReport[]               @relation("SwipeReported")
  swipeReportsReviewed       SwipeReport[]               @relation("SwipeReportReviewer")
  swipeBlocksMade            SwipeBlock[]                @relation("SwipeBlocker")
  swipeBlocksGot             SwipeBlock[]                @relation("SwipeBlocked")
  swipeTakedownsReviewed     SwipeTakedown[]
  cloudMemberships           CloudMember[]
  cloudInvitesSent           CloudInvite[]
  cloudTokens                CloudToken[]
  cloudDeviceCodes           CloudDeviceCode[]
  cloudDeployments           CloudDeployment[]
  cloudEvents                CloudEvent[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// One row per "forgot my password" email. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A change of the account's email waiting for the new address to confirm it (24 hours). Asking
/// again replaces the user's pending one.
model EmailChangeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  newEmail  String    @map("new_email")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

/// A self-registration waiting for its email to be confirmed (24 hours).
model SignupToken {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  name         String
  passwordHash String    @map("password_hash")
  locale       Locale
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  /// The web app the sign-up came from; becomes the account's `signupApp`.
  app          String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email])
  @@map("signup_tokens")
}

model Lead {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  /// Always set from the forms; a prospect the team added may have none yet.
  email             String?
  company           String?
  budget            String?
  /// What they need (web, custom, mobile, design, support, not-sure); replaced budget on the form.
  projectType       String?            @map("project_type")
  message           String
  locale            Locale             @default(EN)
  status            LeadStatus         @default(NEW)
  notes             String?
  /// Why it didn't go ahead (status LOST).
  lostReason        LeadLostReason?    @map("lost_reason")
  /// When to get back to them; the board flags it once it has passed.
  followUpOn        DateTime?          @map("follow_up_on") @db.Date
  /// The client account it became ("Convert to client").
  clientId          String?            @map("client_id") @db.Uuid
  /// A basic-website request from /basic-website/request (architecture 8.2): style, business details.
  siteRequest       Json?              @map("site_request")
  /// The request's instant preview, served at <slug>.<SITES_PREVIEW_DOMAIN> (architecture 8.2).
  previewSlug       String?            @unique @map("preview_slug")
  previewStatus     SitePreviewStatus? @map("preview_status")
  previewBuiltAt    DateTime?          @map("preview_built_at") @db.Timestamptz(3)
  /// When the "what do you think of it?" email about the preview went out (once).
  previewFollowUpAt DateTime?          @map("preview_follow_up_at") @db.Timestamptz(3)
  /// The proposal drafted from the request ("Preparar propuesta").
  proposalId        String?            @unique @map("proposal_id") @db.Uuid
  /// Who on the team added it (a prospect, architecture 8.2); null when it came from a form.
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  replies   LeadReply[]
  client    User?          @relation("LeadClient", fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  proposal  Proposal?      @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  bookings  Booking[]
  purchases SitePurchase[]
  audits    SiteAudit[]

  @@index([status, createdAt])
  @@map("leads")
}

/// An email answer sent to a lead from the admin panel. Only stored once the email went out.
model LeadReply {
  id         String   @id @default(uuid()) @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  /// Copied at the time, so the history keeps it after the author's account is deleted.
  authorName String   @map("author_name")
  subject    String
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_replies")
}

model Post {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  status        PublishStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  coverImageUrl String?       @map("cover_image_url")
  authorId      String?       @map("author_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  author       User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations PostTranslation[]
  tags         PostTag[]

  @@index([status, publishedAt])
  @@map("posts")
}

/// A blog topic, shared by both languages: one slug for URLs, a name per language.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameEs    String   @map("name_es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model PostTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  locale    Locale
  title     String
  excerpt   String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@map("post_translations")
}

model PortfolioItem {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  status            PublishStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  coverImageUrl     String?       @map("cover_image_url")
  clientName        String?       @map("client_name")
  projectUrl        String?       @map("project_url")
  technologies      String[]
  /// Service lines the work covered (the website's service keys: web, custom, mobile, design...).
  services          String[]      @default([])
  sortOrder         Int           @default(0) @map("sort_order")
  /// Who gave the testimonial; the quote and their role are per language (translations).
  testimonialAuthor String?       @map("testimonial_author")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations PortfolioTranslation[]

  @@index([status, sortOrder])
  @@map("portfolio_items")
}

model PortfolioTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  portfolioItemId  String   @map("portfolio_item_id") @db.Uuid
  locale           Locale
  title            String
  summary          String
  content          String
  testimonialQuote String?  @map("testimonial_quote")
  testimonialRole  String?  @map("testimonial_role")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, locale])
  @@map("portfolio_translations")
}

model ClientProject {
  id                    String       @id @default(uuid()) @db.Uuid
  clientId              String       @map("client_id") @db.Uuid
  name                  String
  description           String?
  phase                 ProjectPhase @default(DISCOVERY)
  progress              Int          @default(0)
  startDate             DateTime?    @map("start_date") @db.Timestamptz(3)
  dueDate               DateTime?    @map("due_date") @db.Timestamptz(3)
  stagingUrl            String?      @map("staging_url")
  productionUrl         String?      @map("production_url")
  /// The client sees the hours logged on it (a monthly summary and the entries) in the portal.
  showHours             Boolean      @default(false) @map("show_hours")
  /// SHA-256 of the project's release key, which a deploy pipeline uses to publish releases.
  releaseTokenHash      String?      @unique @map("release_token_hash")
  releaseTokenCreatedAt DateTime?    @map("release_token_created_at") @db.Timestamptz(3)
  /// The client's domain whose renewal is watched (architecture 8.2).
  domainName            String?      @map("domain_name")
  domainSource          DomainSource @default(RDAP) @map("domain_source")
  domainExpiresAt       DateTime?    @map("domain_expires_at") @db.Date
  domainCheckedAt       DateTime?    @map("domain_checked_at") @db.Timestamptz(3)
  /// The last reminder sent: "<expiry day>:<days before>" (30, then 7).
  domainWarnedFor       String?      @map("domain_warned_for")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client      User                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  updates     ProjectUpdate[]
  files       ProjectFile[]
  invoices    ProjectInvoice[]
  milestones  ProjectMilestone[]
  tickets     SupportTicket[]
  proposals   Proposal[]
  time        TimeEntry[]
  drafts      UpdateDraft[]
  tasks       ProjectTask[]
  brief       ProjectBrief?
  monitor     SiteMonitor?
  credentials ProjectCredential[]
  review      ClientReview?
  plan        MaintenancePlan?
  form        SiteForm?
  purchases   SitePurchase[]
  site        ManagedSite?

  @@index([clientId])
  @@map("client_projects")
}

/// A step of a client project the client sees on a timeline, in `position` order.
model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

/// A comment on a project update, by the client or the team.
model ProjectUpdateComment {
  id        String   @id @default(uuid()) @db.Uuid
  updateId  String   @map("update_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  update ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([updateId, createdAt])
  @@map("project_update_comments")
}

model ProjectUpdate {
  id                String              @id @default(uuid()) @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  authorId          String?             @map("author_id") @db.Uuid
  title             String
  body              String
  /// The client is asked to approve it; `approvedAt` is set when they do.
  approvalRequested Boolean             @default(false) @map("approval_requested")
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedById      String?             @map("approved_by_id") @db.Uuid
  /// A release: the version deployed, where, and its address. Null on plain updates.
  version           String?
  environment       ReleaseEnvironment?
  url               String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    ClientProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User?                  @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedBy User?                  @relation("ProjectUpdateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  comments   ProjectUpdateComment[]

  @@index([projectId, createdAt])
  @@map("project_updates")
}

/// A file shared with the client of a project (deliverables, documents). The content lives on disk
/// under UPLOADS_DIR/project-files/<id>; only signed-in users who can see the project download it.
model ProjectFile {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  /// The original file name, cleaned up; used when downloading.
  name         String
  /// As sent by the uploader's browser. Informational only: downloads are always attachments.
  contentType  String   @map("content_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_files")
}

/// An invoice the team issued for a project, uploaded as the PDF of its invoicing tool
/// (architecture 4.2, decision 23). Stored at `UPLOADS_DIR/invoices/<id>`.
model ProjectInvoice {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  /// The invoice's own number, as printed on it.
  number       String    @unique
  issuedOn     DateTime  @map("issued_on") @db.Date
  dueOn        DateTime? @map("due_on") @db.Date
  /// The total, VAT included.
  amountCents  Int       @map("amount_cents")
  currency     String    @default("eur")
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(3)
  fileName     String    @map("file_name")
  size         Int
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId, issuedOn])
  @@map("project_invoices")
}

/// Who changed what: one row per change made from the admin panel or to one's own account.
/// Actor name and target label are copied at the time, so entries survive renames and deletes.
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String   @map("actor_name")
  /// `<target>.<verb>`, e.g. `post.published` (see ACTIVITY_ACTIONS in the activity module).
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  /// Extra facts about the change, e.g. `{ "status": "WON" }` or the fields that changed.
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, createdAt])
  @@map("activity_log")
}

/// A reusable text for lead replies and project comments; `{name}` and `{project}` are filled in
/// by the admin panel when it is inserted.
model SavedReply {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("saved_replies")
}

enum TicketType {
  BUG
  CHANGE
  QUESTION
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

/// A support request a client opens from the portal: a bug, a change or a question.
model SupportTicket {
  id         String         @id @default(uuid()) @db.Uuid
  /// Short reference shown to people (#12).
  number     Int            @unique @default(autoincrement())
  clientId   String         @map("client_id") @db.Uuid
  projectId  String?        @map("project_id") @db.Uuid
  type       TicketType
  priority   TicketPriority @default(NORMAL)
  status     TicketStatus   @default(OPEN)
  title      String
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client   User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages TicketMessage[]
  files    TicketAttachment[]
  tasks    ProjectTask[]

  @@index([status, updatedAt])
  @@index([clientId, updatedAt])
  @@map("support_tickets")
}

/// A message in a support request's conversation; the first one is the description.
model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// A file added to a support request by the client or the team (a screenshot, a log...). Stored
/// on disk at UPLOADS_DIR/ticket-files/<id>, like project files.
model TicketAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  name         String
  contentType  String   @map("content_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_attachments")
}

/// DRAFT: only the team sees it. SENT: the client can accept or decline it (until `validUntil`).
/// WITHDRAWN: the team took it back after sending it.
enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// A proposal or quote for a client: what will be done, item by item with prices, and the terms.
model Proposal {
  id               String         @id @default(uuid()) @db.Uuid
  /// Short reference shown to people (#7).
  number           Int            @unique @default(autoincrement())
  clientId         String         @map("client_id") @db.Uuid
  projectId        String?        @map("project_id") @db.Uuid
  createdById      String?        @map("created_by_id") @db.Uuid
  title            String
  /// Markdown: the scope, what is included and what isn't.
  summary          String
  /// Markdown: payment schedule, deadlines, conditions.
  terms            String?
  currency         String         @default("EUR")
  /// Last day the client can accept it.
  validUntil       DateTime?      @map("valid_until") @db.Date
  status           ProposalStatus @default(DRAFT)
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz(3)
  respondedAt      DateTime?      @map("responded_at") @db.Timestamptz(3)
  /// The full name the client typed to accept it.
  acceptedName     String?        @map("accepted_name")
  declineReason    String?        @map("decline_reason")
  /// When the client was reminded that it is about to expire (once).
  expiryRemindedAt DateTime?      @map("expiry_reminded_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client    User           @relation("ProposalClient", fields: [clientId], references: [id], onDelete: Cascade)
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("ProposalAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  lead      Lead?

  @@index([status, updatedAt])
  @@index([clientId, updatedAt])
  @@map("proposals")
}

/// A line of a proposal; amounts in cents.
model ProposalItem {
  id          String @id @default(uuid()) @db.Uuid
  proposalId  String @map("proposal_id") @db.Uuid
  position    Int
  description String
  quantity    Int
  unitPrice   Int    @map("unit_price")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, position])
  @@map("proposal_items")
}

/// Time spent on a client project: who, which day (Madrid), how long and on what.
model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  date        DateTime @db.Date
  minutes     Int
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([date])
  @@map("time_entries")
}

/// An update prepared outside the panel (a deploy pipeline, a summary of the work done) waiting for
/// the team to review it. Publishing it creates the ProjectUpdate and removes the draft.
model UpdateDraft {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @map("project_id") @db.Uuid
  title       String
  body        String
  /// Set when it is a release.
  version     String?
  environment ReleaseEnvironment?
  url         String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("update_drafts")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Work to do on a client project: a change the client asked for (from a support request) or one
/// the team planned. The client sees titles and statuses; the description is for the team.
model ProjectTask {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  /// The support request it came from, when it did.
  ticketId    String?    @map("ticket_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  doneAt      DateTime?  @map("done_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket  SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ticketId])
  @@map("project_tasks")
}

/// Site settings edited in the admin panel, one JSON document per key (e.g. `calculator`).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// A video call booked from the website in one of the team's free slots.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  email           String
  company         String?
  message         String?
  locale          Locale        @default(EN)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  status          BookingStatus @default(CONFIRMED)
  /// The start while confirmed, null once cancelled: two confirmed calls can't share a start.
  slotKey         DateTime?     @unique @map("slot_key") @db.Timestamptz(3)
  /// SHA-256 of the token in the visitor's cancel link.
  cancelTokenHash String        @unique @map("cancel_token_hash")
  /// Calendar invitation revision (bumped when it is cancelled).
  sequence        Int           @default(0)
  leadId          String?       @map("lead_id") @db.Uuid
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@map("bookings")
}

enum BriefStatus {
  REQUESTED
  SUBMITTED
}

/// The client's answers to the project questionnaire (goals, audience, must-haves, brand...), one
/// per project. Saved as they go (REQUESTED) until they send it (SUBMITTED); they can edit it after.
model ProjectBrief {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @unique @map("project_id") @db.Uuid
  status      BriefStatus @default(REQUESTED)
  /// The answers, by question key (see briefs.schemas.ts).
  answers     Json        @default("{}")
  requestedAt DateTime    @default(now()) @map("requested_at") @db.Timestamptz(3)
  submittedAt DateTime?   @map("submitted_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_briefs")
}

enum SiteStatus {
  UNKNOWN
  UP
  DOWN
}

/// Uptime monitoring of a client project's production site (its `productionUrl`).
model SiteMonitor {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @unique @map("project_id") @db.Uuid
  enabled       Boolean    @default(true)
  status        SiteStatus @default(UNKNOWN)
  /// When the current status started.
  statusSince   DateTime   @default(now()) @map("status_since") @db.Timestamptz(3)
  /// Failed checks in a row (DOWN after two).
  failures      Int        @default(0)
  lastCheckedAt DateTime?  @map("last_checked_at") @db.Timestamptz(3)
  lastError     String?    @map("last_error")
  certExpiresAt DateTime?  @map("cert_expires_at") @db.Timestamptz(3)
  certCheckedAt DateTime?  @map("cert_checked_at") @db.Timestamptz(3)
  /// The certificate expiry the team was last warned about (once per certificate).
  certWarnedFor DateTime?  @map("cert_warned_for") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  SiteCheck[]

  @@map("site_monitors")
}

/// One check of a monitored site; kept 90 days.
model SiteCheck {
  id         String   @id @default(uuid()) @db.Uuid
  monitorId  String   @map("monitor_id") @db.Uuid
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  ok         Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  error      String?

  monitor SiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("site_checks")
}

/// Access the client shares for their project (hosting, domain, a service account), encrypted at
/// rest (AES-256-GCM, CREDENTIALS_SECRET). Clients can add and delete; only the team reads the
/// secret, and every read is logged.
model ProjectCredential {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  label       String
  url         String?
  username    String?
  /// Sealed (see secret-box.ts).
  secret      String
  /// Sealed too, when given.
  notes       String?
  /// When the team last revealed it.
  viewedAt    DateTime? @map("viewed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_credentials")
}

enum ReviewStatus {
  REQUESTED
  SUBMITTED
  PUBLISHED
  HIDDEN
}

/// The client's rating and words about a finished project. Asked for when it is launched; it goes
/// on the website only with their consent and once the team publishes it.
model ClientReview {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @unique @map("project_id") @db.Uuid
  status      ReviewStatus @default(REQUESTED)
  /// 1 to 5.
  rating      Int?
  quote       String?
  authorName  String?      @map("author_name")
  /// Their role and company, e.g. "CEO, Clínica Sol".
  authorRole  String?      @map("author_role")
  /// They allow it on the website.
  consent     Boolean      @default(false)
  /// The language they wrote it in (it shows on the site in that language).
  locale      Locale       @default(EN)
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  submittedAt DateTime?    @map("submitted_at") @db.Timestamptz(3)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@map("client_reviews")
}

/// A monthly hour allowance for a project (maintenance and support), drawn down by its time
/// entries per Madrid calendar month. The team is warned at `alertPercent` and at 100 %.
model MaintenancePlan {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  active         Boolean  @default(true)
  name           String
  monthlyMinutes Int      @map("monthly_minutes")
  alertPercent   Int      @default(80) @map("alert_percent")
  /// The last month (`yyyy-mm`) and level (alertPercent or 100) the team was warned about.
  alertedMonth   String?  @map("alerted_month")
  alertedLevel   Int      @default(0) @map("alerted_level")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("maintenance_plans")
}

/// The contact form of a client site the team hosts. The site posts to `/v1/forms/:key` and the
/// message is emailed to `recipients`; only a counter is kept.
model SiteForm {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @unique @map("project_id") @db.Uuid
  /// Public (it is in the site's HTML); replacing it stops copies of the old one.
  key              String    @unique
  enabled          Boolean   @default(true)
  recipients       String[]
  submissions      Int       @default(0)
  lastSubmissionAt DateTime? @map("last_submission_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  days     SiteFormDay[]
  messages SiteFormMessage[]

  @@map("site_forms")
}

/// A starting point for proposals ("Web básica"): what a new proposal is filled in with.
model ProposalTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  title     String
  summary   String
  terms     String?
  /// Days the proposal stays open from the day it is created.
  validDays Int?     @map("valid_days")
  /// `[{ description, quantity, unitPrice }]`, amounts in cents.
  items     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("proposal_templates")
}

/// Where a managed site's last build stands.
enum SiteBuildStatus {
  NONE
  BUILDING
  LIVE
  FAILED
}

/// A basic website whose content lives here and which site-builder builds from the web-basica
/// template (architecture 8.2): one per project. Previewed at <slug>.<SITES_PREVIEW_DOMAIN>.
model ManagedSite {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @unique @map("project_id") @db.Uuid
  /// Folder and preview subdomain: [a-z0-9-].
  slug            String           @unique
  /// The demo it started from; its images are available by name.
  preset          String
  /// The template's `Site` object (without `url`, `form` and `demo`, which are set when built).
  content         Json
  /// The client's own domain, when there is one.
  domain          String?          @unique
  /// Null without a domain; the canonical address is the domain only once LIVE.
  domainState     SiteDomainState? @map("domain_state")
  domainCheckedAt DateTime?        @map("domain_checked_at") @db.Timestamptz(3)
  /// Where the domain's email goes (its MX records), checked with the domain.
  mailState       SiteMailState?   @map("mail_state")
  status          SiteBuildStatus  @default(NONE)
  lastBuildAt     DateTime?        @map("last_build_at") @db.Timestamptz(3)
  lastBuildError  String?          @map("last_build_error")
  release         String?
  /// `yyyy-mm`: the last month its monthly report went out for.
  reportedMonth   String?          @map("reported_month")
  /// Its website in Umami (cookieless visit statistics), created on its first build.
  umamiWebsiteId  String?          @map("umami_website_id")
  /// The draft the client is editing (decision 18): the whole content, valid as `content`.
  draftContent    Json?            @map("draft_content")
  /// The style the draft starts from, when the client changed it.
  draftPreset     String?          @map("draft_preset")
  draftUpdatedAt  DateTime?        @map("draft_updated_at") @db.Timestamptz(3)
  /// Random: the draft's preview is served at /site-draft/<key>/.
  draftKey        String?          @unique @map("draft_key")
  /// The menu extra (architecture 8.2): turned on by the team, billed apart.
  menuEnabled     Boolean          @default(false) @map("menu_enabled")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   ClientProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions ManagedSiteRevision[]

  @@map("managed_sites")
}

/// The content a managed site had before a change (the last 20 are kept).
model ManagedSiteRevision {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  content   Json
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site   ManagedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@map("managed_site_revisions")
}

/// A message a managed site's form received, kept 12 months for the client's portal (decision 31).
model SiteFormMessage {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form SiteForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([createdAt])
  @@map("site_form_messages")
}

/// Messages a site form relayed on a day (Madrid), for the client's visits chart.
model SiteFormDay {
  formId String   @map("form_id") @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)

  form SiteForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([formId, day])
  @@map("site_form_days")
}

/// Where a project's domain expiry comes from: the registry's RDAP, typed by the team (`.es`
/// has no public RDAP), or OVH's API when the team is the domain's technical contact.
enum DomainSource {
  RDAP
  MANUAL
  OVH
}

/// Where a managed site's own domain stands: nobody has registered it, it is registered but
/// doesn't resolve to this server, or it resolves here and answers over HTTPS.
enum SiteDomainState {
  UNREGISTERED
  ELSEWHERE
  LIVE
}

/// A website request's preview: being built, online, failed, or taken down.
/// A request's preview bought online through Stripe Checkout (architecture 8.2, decision 20).
model SitePurchase {
  id              String             @id @default(uuid()) @db.Uuid
  leadId          String             @map("lead_id") @db.Uuid
  /// The Stripe Checkout Session.
  stripeSessionId String             @unique @map("stripe_session_id")
  /// The total charged, VAT included.
  amountCents     Int                @map("amount_cents")
  currency        String
  status          SitePurchaseStatus @default(PENDING)
  /// The buyer's email, from Stripe.
  email           String?
  paidAt          DateTime?          @map("paid_at") @db.Timestamptz(3)
  /// The project of the site made from it.
  projectId       String?            @map("project_id") @db.Uuid
  /// The invoice Stripe issued for it.
  stripeInvoiceId String?            @map("stripe_invoice_id")
  /// Why the site couldn't be made on its own: the team finishes it.
  error           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead    Lead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  project ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("site_purchases")
}

enum SitePurchaseStatus {
  PENDING
  PAID
  EXPIRED
}

enum SitePreviewStatus {
  BUILDING
  READY
  FAILED
  REMOVED
}

/// A managed site domain's email: no MX records, OVH's mail servers, or another provider.
enum SiteMailState {
  NONE
  OVH
  OTHER
}

// ---------------------------------------------------------------------------------------------
// Random video chat (videochat.codeqlick.com). Spec: the Notion roadmap row and architecture 4.7.

/// Explicit content between consenting adults is allowed (owner's decision, 2026-11-07), so
/// nudity is not a reason. A MINOR report suspends the account at once until reviewed.
enum VideochatReportReason {
  MINOR
  /// Pressure, no consent, or recording/sharing someone without their consent.
  NON_CONSENSUAL
  /// Illegal content (violence, animals, anything unlawful).
  ILLEGAL
  HARASSMENT
  HATE
  SPAM
  OTHER
}

enum VideochatReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// Whether a user may use the video chat: 18+ confirmed, rules accepted, not suspended. The date
/// of birth is checked when given and not stored.
enum VideochatVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model VideochatProfile {
  userId             String                      @id @map("user_id") @db.Uuid
  adultConfirmedAt   DateTime                    @map("adult_confirmed_at") @db.Timestamptz(3)
  termsVersion       String                      @map("terms_version")
  termsAcceptedAt    DateTime                    @map("terms_accepted_at") @db.Timestamptz(3)
  /// Age checked for real (an age verification provider, or the team by hand); required when
  /// VIDEOCHAT_AGE_VERIFICATION_REQUIRED is on. Null: only declared.
  ageVerifiedAt      DateTime?                   @map("age_verified_at") @db.Timestamptz(3)
  /// Set by the team, or automatically after several reports; null: allowed.
  suspendedAt        DateTime?                   @map("suspended_at") @db.Timestamptz(3)
  /// End of a timed suspension; null with suspendedAt: until the team lifts it.
  suspendedUntil     DateTime?                   @map("suspended_until") @db.Timestamptz(3)
  suspensionReason   String?                     @map("suspension_reason")
  /// Public profile shown to partners (never the account name) and the matching filters.
  nickname           String?
  gender             VideochatGender?
  /// Who they want to meet; empty: anyone.
  seeking            VideochatGender[]           @default([])
  /// ISO 3166-1 alpha-2.
  country            String?
  /// ISO 639-1.
  language           String?
  sameCountryOnly    Boolean                     @default(false) @map("same_country_only")
  sameLanguageOnly   Boolean                     @default(false) @map("same_language_only")
  /// Up to 5 interests from the fixed list in videochat.schemas.ts (INTERESTS).
  interests          String[]                    @default([])
  /// Last "someone is waiting" notification sent to this account (at most one every 6 hours).
  pushNotifiedAt     DateTime?                   @map("push_notified_at") @db.Timestamptz(3)
  /// Wants a notification when the video chat is at its busiest (peak time alerts).
  peakAlerts         Boolean                     @default(false) @map("peak_alerts")
  /// Last peak time alert sent to this account (at most one a day).
  peakNotifiedAt     DateTime?                   @map("peak_notified_at") @db.Timestamptz(3)
  /// The team marked the account "not suspicious": hidden from that list for 30 days.
  suspicionClearedAt DateTime?                   @map("suspicion_cleared_at") @db.Timestamptz(3)
  /// Optional photo verification (the person holding a paper with their nickname and the date),
  /// reviewed by the team: approved shows the "verified" badge to partners and contacts.
  verificationStatus VideochatVerificationStatus @default(NONE) @map("verification_status")
  /// File of the photo (private storage) while it waits for review; deleted once decided.
  verificationKey    String?                     @map("verification_key")
  verificationNote   String?                     @map("verification_note")
  verificationSentAt DateTime?                   @map("verification_sent_at") @db.Timestamptz(3)
  verifiedAt         DateTime?                   @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([suspendedAt])
  @@index([verificationStatus, verificationSentAt])
  @@map("videochat_profiles")
}

/// A browser that asked to be told when someone is in the video chat (Web Push; architecture 4.7).
model VideochatPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Language of the notification text (en or es).
  locale    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("videochat_push_subscriptions")
}

model VideochatReport {
  id           String                @id @default(uuid()) @db.Uuid
  reporterId   String                @map("reporter_id") @db.Uuid
  reportedId   String                @map("reported_id") @db.Uuid
  reason       VideochatReportReason
  details      String?
  /// The call's last text messages: [{ from: 'reporter' | 'reported', text, at }].
  transcript   Json                  @default("[]")
  status       VideochatReportStatus @default(OPEN)
  reviewedById String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter   User  @relation("VideochatReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User  @relation("VideochatReported", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VideochatReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId, createdAt])
  @@map("videochat_reports")
}

/// Two people who blocked each other are never matched again (either direction).
model VideochatBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("VideochatBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("VideochatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("videochat_blocks")
}

/// "I like them" after a call; two people who liked each other are contacts (architecture 4.7).
model VideochatLike {
  fromId    String   @map("from_id") @db.Uuid
  toId      String   @map("to_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  from User @relation("VideochatLiker", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("VideochatLiked", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
  @@map("videochat_likes")
}

/// One finished video chat call, anonymous: no user, only times (statistics; architecture 4.7).
model VideochatCallLog {
  id          String   @id @default(uuid()) @db.Uuid
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  durationSec Int      @map("duration_sec")
  /// Average time the two people waited before this match; null when unknown.
  waitSec     Int?     @map("wait_sec")

  @@index([startedAt])
  @@map("videochat_call_logs")
}

/// An account used the video chat on that day (Europe/Madrid), for daily counts. Kept 180 days.
model VideochatActiveDay {
  day         DateTime @db.Date
  userId      String   @map("user_id") @db.Uuid
  /// Calls that day, those under 10 s, and those the other person ended under 10 s.
  calls       Int      @default(0)
  shortCalls  Int      @default(0) @map("short_calls")
  skippedFast Int      @default(0) @map("skipped_fast")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
  @@index([userId])
  @@map("videochat_active_days")
}

enum VideochatGender {
  WOMAN
  MAN
  NONBINARY
}

enum VideochatSanctionKind {
  SUSPENDED
  LIFTED
}

enum VideochatAppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

/// History of suspensions and lifts of a person's video chat access.
model VideochatSanction {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  kind      VideochatSanctionKind
  reason    String?
  /// End of a timed suspension; null: until lifted.
  until     DateTime?             @db.Timestamptz(3)
  /// Who did it; null: automatic.
  byId      String?               @map("by_id") @db.Uuid
  reportId  String?               @map("report_id") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User             @relation("VideochatSanctioned", fields: [userId], references: [id], onDelete: Cascade)
  by     User?            @relation("VideochatSanctionedBy", fields: [byId], references: [id], onDelete: SetNull)
  appeal VideochatAppeal?

  @@index([userId, createdAt])
  @@map("videochat_sanctions")
}

/// A suspended person's request to lift their suspension (one per suspension).
model VideochatAppeal {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  sanctionId   String                @unique @map("sanction_id") @db.Uuid
  message      String
  status       VideochatAppealStatus @default(OPEN)
  response     String?
  reviewedById String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User              @relation("VideochatAppellant", fields: [userId], references: [id], onDelete: Cascade)
  sanction   VideochatSanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("VideochatAppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("videochat_appeals")
}

/// A meeting room of meetings.codeqlick.com (architecture 4.8): a permanent link until its owner
/// deletes it. Nothing about the meetings held in it is stored, only when it was last used.
model MeetingRoom {
  id         String    @id @default(uuid()) @db.Uuid
  /// `abc-defg-hij`: the room's link.
  code       String    @unique @db.VarChar(12)
  ownerId    String    @map("owner_id") @db.Uuid
  title      String    @db.VarChar(80)
  /// Waiting room: everyone but the owner knocks and waits to be let in.
  lobby      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookingPages BookingPage[]

  @@index([ownerId, createdAt])
  @@map("meeting_rooms")
}

/// Citas (architecture 4.9): a person's public booking page at citas.codeqlick.com/<slug>.
model BookingPage {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  /// The page's link; 3–40 lowercase letters, digits and dashes.
  slug            String   @unique @db.VarChar(40)
  title           String   @db.VarChar(80)
  description     String   @default("") @db.VarChar(500)
  durationMinutes Int      @map("duration_minutes")
  /// Where it happens (an address, "by phone"…); empty when only the video call.
  location        String   @default("") @db.VarChar(200)
  /// The Meetings room whose link goes in every appointment, when the page offers video.
  meetingRoomId   String?  @map("meeting_room_id") @db.Uuid
  askPhone        Boolean  @default(false) @map("ask_phone")
  /// IANA time zone of the free hours (e.g. Europe/Madrid).
  timeZone        String   @map("time_zone") @db.VarChar(64)
  /// Free hours per weekday: { mon: [{ start: 'HH:MM', end: 'HH:MM' }], … }.
  weekly          Json
  minNoticeHours  Int      @map("min_notice_hours")
  horizonDays     Int      @map("horizon_days")
  /// Paused pages show their link but take no bookings.
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  meetingRoom  MeetingRoom?  @relation(fields: [meetingRoomId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([ownerId, createdAt])
  @@map("booking_pages")
}

/// Citas: a time someone booked on a booking page.
model Appointment {
  id              String        @id @default(uuid()) @db.Uuid
  pageId          String        @map("page_id") @db.Uuid
  /// The page's owner (kept here so their free times leave out all their appointments).
  ownerId         String        @map("owner_id") @db.Uuid
  name            String        @db.VarChar(120)
  email           String        @db.VarChar(254)
  phone           String?       @db.VarChar(40)
  note            String?       @db.VarChar(500)
  locale          Locale        @default(ES)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  status          BookingStatus @default(CONFIRMED)
  /// SHA-256 of the token in the cancel link sent to whoever booked.
  cancelTokenHash String        @unique @map("cancel_token_hash")
  /// Calendar invitation revision (bumped when it is cancelled).
  sequence        Int           @default(0)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  /// When the reminder email went out (about 24 h before); null until then.
  reminderSentAt  DateTime?     @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  page  BookingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, startsAt])
  @@index([pageId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

// ---- Swipe (architecture 4.10) -----------------------------------------------------------------

enum SwipeGender {
  WOMAN
  MAN
  NONBINARY
}

/// The verification photo of someone who wants to upload: themselves holding a paper with their
/// nickname and the date. The team approves it before any of their photos can be sent.
enum SwipeVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum SwipePhotoStatus {
  /// Waiting for the team: nobody else sees it.
  PENDING
  LIVE
  REJECTED
  /// Taken down after a report or a removal request, or by the team.
  HIDDEN
}

enum SwipeReportReason {
  MINOR
  /// Shared without the consent of the person in it.
  NON_CONSENSUAL
  /// Someone else's photo.
  STOLEN
  ILLEGAL
  HARASSMENT
  SPAM
  OTHER
}

enum SwipeReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum SwipeTakedownStatus {
  OPEN
  /// The photo was removed.
  REMOVED
  /// Nothing to remove (not found, or not the person's image).
  CLOSED
}

/// A person in Swipe: 18+ declared (the date of birth is checked, not stored), rules accepted,
/// public profile, and their verification as an uploader.
model SwipeProfile {
  userId             String                  @id @map("user_id") @db.Uuid
  adultConfirmedAt   DateTime                @map("adult_confirmed_at") @db.Timestamptz(3)
  termsVersion       String                  @map("terms_version")
  termsAcceptedAt    DateTime                @map("terms_accepted_at") @db.Timestamptz(3)
  nickname           String?
  gender             SwipeGender?
  /// Whose photos they want to see; empty: everyone.
  seeking            SwipeGender[]           @default([])
  /// Up to 5 from the fixed list in swipe.schemas.ts.
  interests          String[]                @default([])
  /// A sentence about them, shown on cards and chats.
  bio                String?                 @db.VarChar(160)
  /// Only the year of birth (for the age filter); the full date is never stored.
  birthYear          Int?                    @map("birth_year")
  /// ISO 3166-1 alpha-2, optional.
  country            String?                 @db.VarChar(2)
  /// Age range of the photos they want to see.
  ageMin             Int                     @default(18) @map("age_min")
  ageMax             Int                     @default(99) @map("age_max")
  /// Only people from their own country.
  sameCountry        Boolean                 @default(false) @map("same_country")
  /// Emails about matches, messages, "love" and the team's decisions.
  emailAlerts        Boolean                 @default(true) @map("email_alerts")
  /// Photos shown blurred until tapped.
  blurPhotos         Boolean                 @default(false) @map("blur_photos")
  verificationStatus SwipeVerificationStatus @default(NONE) @map("verification_status")
  /// File of the verification photo (private storage), while there is one.
  verificationKey    String?                 @map("verification_key")
  verificationNote   String?                 @map("verification_note")
  verificationSentAt DateTime?               @map("verification_sent_at") @db.Timestamptz(3)
  verifiedAt         DateTime?               @map("verified_at") @db.Timestamptz(3)
  suspendedAt        DateTime?               @map("suspended_at") @db.Timestamptz(3)
  /// End of a timed suspension; null with suspendedAt: until the team lifts it.
  suspendedUntil     DateTime?               @map("suspended_until") @db.Timestamptz(3)
  suspensionReason   String?                 @map("suspension_reason")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus, verificationSentAt])
  @@map("swipe_profiles")
}

/// A photo someone uploaded. Re-encoded on upload (no metadata) and kept in private storage.
model SwipePhoto {
  id           String           @id @default(uuid()) @db.Uuid
  /// Short public reference shown on the card, for reports and removal requests.
  ref          String           @unique @db.VarChar(12)
  ownerId      String           @map("owner_id") @db.Uuid
  storageKey   String           @unique @map("storage_key")
  width        Int
  height       Int
  /// Perceptual hash (dHash, 16 hex digits): re-uploads of a removed image are refused.
  hash         String           @db.VarChar(16)
  status       SwipePhotoStatus @default(PENDING)
  rejectReason String?          @map("reject_reason")
  likes        Int              @default(0)
  /// The stored file carries the burnt-in watermark (nickname · ref · swipe.codeqlick.com).
  watermarked  Boolean          @default(false)
  /// In the owner's private album: never in the deck, only their matches see it.
  inAlbum      Boolean          @default(false) @map("in_album")
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  owner      User            @relation("SwipePhotoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("SwipePhotoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  votes      SwipeVote[]
  reports    SwipeReport[]
  takedowns  SwipeTakedown[]

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@map("swipe_photos")
}

/// A like or a skip. `ownerId` is the photo's owner, kept here to find matches quickly.
model SwipeVote {
  voterId   String   @map("voter_id") @db.Uuid
  photoId   String   @map("photo_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  like      Boolean
  /// A "love": the owner is told and the voter's photos come first in their deck.
  superLike Boolean  @default(false) @map("super_like")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voter User       @relation(fields: [voterId], references: [id], onDelete: Cascade)
  photo SwipePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([voterId, photoId])
  @@index([voterId, ownerId, like])
  @@index([ownerId, createdAt])
  @@map("swipe_votes")
}

/// Two people who liked a photo of each other. `userAId` < `userBId`.
model SwipeMatch {
  id            String    @id @default(uuid()) @db.Uuid
  userAId       String    @map("user_a_id") @db.Uuid
  userBId       String    @map("user_b_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  readAAt       DateTime? @map("read_a_at") @db.Timestamptz(3)
  readBAt       DateTime? @map("read_b_at") @db.Timestamptz(3)
  /// When each was last emailed about unread messages (again only after reading).
  notifiedAAt   DateTime? @map("notified_a_at") @db.Timestamptz(3)
  notifiedBAt   DateTime? @map("notified_b_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userA    User           @relation("SwipeMatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User           @relation("SwipeMatchB", fields: [userBId], references: [id], onDelete: Cascade)
  messages SwipeMessage[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("swipe_matches")
}

/// A text message between two matches (text only: no images, nothing to moderate before).
model SwipeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  match  SwipeMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("swipe_messages")
}

model SwipeReport {
  id           String            @id @default(uuid()) @db.Uuid
  reporterId   String            @map("reporter_id") @db.Uuid
  reportedId   String            @map("reported_id") @db.Uuid
  photoId      String?           @map("photo_id") @db.Uuid
  reason       SwipeReportReason
  details      String?           @db.VarChar(1000)
  /// From a match's chat: its last messages, [{ from: 'reporter' | 'reported', text, at }].
  transcript   Json              @default("[]")
  status       SwipeReportStatus @default(OPEN)
  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter   User        @relation("SwipeReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User        @relation("SwipeReported", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewedBy User?       @relation("SwipeReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  photo      SwipePhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("swipe_reports")
}

/// Either direction: they never see each other's photos again.
model SwipeBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("SwipeBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SwipeBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("swipe_blocks")
}

/// A removal request from anyone, with or without an account (EU Digital Services Act).
model SwipeTakedown {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @db.VarChar(254)
  /// What they gave: the photo's reference, or a description.
  photoRef     String?             @map("photo_ref") @db.VarChar(40)
  photoId      String?             @map("photo_id") @db.Uuid
  reason       SwipeReportReason
  details      String              @db.VarChar(2000)
  /// Language of the emails sent to them.
  locale       Locale              @default(ES)
  status       SwipeTakedownStatus @default(OPEN)
  response     String?             @db.VarChar(2000)
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  photo      SwipePhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  reviewedBy User?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("swipe_takedowns")
}

/// A browser that gets Swipe's Web Push notifications (matches, messages, "love").
model SwipePushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Language of the notification text (en or es).
  locale    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("swipe_push_subscriptions")
}

/// Perceptual hashes of removed images: an upload that looks the same is refused.
model SwipeBlockedHash {
  hash      String            @id @db.VarChar(16)
  reason    SwipeReportReason
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("swipe_blocked_hashes")
}

/// Where a recorded error happened: the API, or the website (its server or a visitor's browser).
enum ErrorSource {
  API
  WEB_SERVER
  WEB_BROWSER
}

/// The same unexpected error, grouped by its fingerprint (Admin → Errors, architecture 4.11).
model ErrorGroup {
  id          String      @id @default(uuid()) @db.Uuid
  /// SHA-256 of the source, the message without numbers or ids, and the first stack frame.
  fingerprint String      @unique @db.VarChar(64)
  source      ErrorSource
  message     String      @db.VarChar(1000)
  /// The last occurrence's stack trace.
  stack       String?     @db.VarChar(8000)
  /// The last occurrence's method and path (no query string).
  method      String?     @db.VarChar(10)
  path        String?     @db.VarChar(500)
  /// The last occurrence's API request id or Next.js digest, to find it in the logs.
  reference   String?     @db.VarChar(100)
  userAgent   String?     @map("user_agent") @db.VarChar(300)
  count       Int         @default(1)
  firstSeenAt DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Set when the team marks it fixed; it opens again (and alerts) if it happens again.
  resolvedAt  DateTime?   @map("resolved_at") @db.Timestamptz(3)

  @@index([resolvedAt, lastSeenAt])
  @@map("error_groups")
}

/// A free website check (architecture 4.12): a visitor's site analysed in the background.
model SiteAudit {
  id         String          @id @default(uuid()) @db.Uuid
  /// The start URL, normalised (scheme, host and path).
  url        String
  host       String
  name       String?
  email      String
  locale     Locale
  status     SiteAuditStatus @default(PENDING)
  /// 0–100, once DONE.
  score      Int?
  /// The final URL, each category's score and each check's id, status and values.
  result     Json?
  /// Why it failed (English), when FAILED.
  error      String?
  leadId     String?         @map("lead_id") @db.Uuid
  finishedAt DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@map("site_audits")
}

enum SiteAuditStatus {
  PENDING
  DONE
  FAILED
}

// ── Codeqlick Cloud (architecture 4.13) ─────────────────────────────────────────────────────────

enum CloudPlan {
  FREE
  PRO
}

enum CloudRole {
  OWNER
  ADMIN
  MEMBER
}

enum CloudTarget {
  PREVIEW
  PRODUCTION
}

enum CloudDomainState {
  PENDING
  VERIFIED
  LIVE
  ERROR
}

enum CloudReportReason {
  PHISHING
  MALWARE
  ILLEGAL
  COPYRIGHT
  SEXUAL
  SPAM
  OTHER
}

enum CloudReportStatus {
  OPEN
  CLOSED
}

/// What owns Cloud projects; people join it as members.
model CloudTeam {
  id        String    @id @default(uuid()) @db.Uuid
  /// The console's URLs: 3–30 lowercase letters, digits and single dashes.
  slug      String    @unique @db.VarChar(30)
  name      String    @db.VarChar(60)
  plan      CloudPlan @default(FREE)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members                 CloudMember[]
  invites                 CloudInvite[]
  tokens                  CloudToken[]
  projects                CloudProject[]
  events                  CloudEvent[]
  monitors                CloudMonitor[]
  statusPage              CloudStatusPage?
  cloudAudits             CloudAudit[]
  gitInstallations        CloudGitInstallation[]
  /// The Madrid month (`YYYY-MM`) whose analytics limit the owners were told about.
  analyticsOverLimitMonth String?                @map("analytics_over_limit_month") @db.VarChar(7)

  @@map("cloud_teams")
}

model CloudMember {
  id              String    @id @default(uuid()) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            CloudRole
  /// The Cloud terms' version this person accepted, and when.
  termsVersion    String    @map("terms_version") @db.VarChar(20)
  termsAcceptedAt DateTime  @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  team CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("cloud_members")
}

model CloudInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  email       String    @db.VarChar(254)
  role        CloudRole
  /// SHA-256 of the token in the invitation's link.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team      CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("cloud_invites")
}

/// A personal API token (`cqk_…`); only its SHA-256 is stored.
model CloudToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Restricted to this team; null = every team of its person.
  teamId     String?   @map("team_id") @db.Uuid
  name       String    @db.VarChar(80)
  /// The token's first 12 characters, to recognise it.
  prefix     String    @db.VarChar(12)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp String?   @map("last_used_ip") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        CloudTeam?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deployments CloudDeployment[]

  @@index([userId])
  @@map("cloud_tokens")
}

/// A CLI sign-in waiting for the person to approve it in the browser (device flow).
model CloudDeviceCode {
  id             String    @id @default(uuid()) @db.Uuid
  deviceCodeHash String    @unique @map("device_code_hash") @db.VarChar(64)
  /// ABCDEFGH (shown as ABCD-EFGH).
  userCode       String    @unique @map("user_code") @db.VarChar(8)
  clientName     String    @map("client_name") @db.VarChar(60)
  userId         String?   @map("user_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  deniedAt       DateTime? @map("denied_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  lastPolledAt   DateTime? @map("last_polled_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("cloud_device_codes")
}

model CloudProject {
  id                     String    @id @default(uuid()) @db.Uuid
  teamId                 String    @map("team_id") @db.Uuid
  /// Its address `<slug>.<CLOUD_HOSTING_DOMAIN>`: unique across Cloud, kept 30 days after deletion.
  slug                   String    @unique @db.VarChar(40)
  name                   String    @db.VarChar(60)
  productionDeploymentId String?   @unique @map("production_deployment_id") @db.Uuid
  suspendedAt            DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedReason        String?   @map("suspended_reason") @db.VarChar(500)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Builds from Git (architecture 4.13): the linked installation and repository, and settings.
  gitInstallationId      BigInt?   @map("git_installation_id")
  gitRepoId              BigInt?   @map("git_repo_id")
  gitRepo                String?   @map("git_repo") @db.VarChar(200)
  gitBranch              String    @default("main") @map("git_branch") @db.VarChar(200)
  rootDir                String    @default("") @map("root_dir") @db.VarChar(200)
  installCommand         String    @default("npm ci") @map("install_command") @db.VarChar(300)
  buildCommand           String    @default("npm run build") @map("build_command") @db.VarChar(300)
  outputDir              String    @default("dist") @map("output_dir") @db.VarChar(200)
  nodeVersion            String    @default("24") @map("node_version") @db.VarChar(4)
  buildBranches          Boolean   @default(true) @map("build_branches")
  buildPullRequests      Boolean   @default(true) @map("build_pull_requests")
  /// Web analytics switched on (architecture 4.13 "Web analytics", decision 44).
  analytics              Boolean   @default(false)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  team            CloudTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  production      CloudDeployment?      @relation("CloudProduction", fields: [productionDeploymentId], references: [id], onDelete: SetNull)
  deployments     CloudDeployment[]     @relation("CloudDeployments")
  domains         CloudDomain[]
  reports         CloudReport[]
  forms           CloudForm[]
  envVars         CloudEnvVar[]
  builds          CloudBuild[]
  prComments      CloudPullComment[]
  notifyChannels  CloudNotifyChannel[]
  analyticsEvents CloudAnalyticsEvent[]
  kvEntries       CloudKvEntry[]

  @@index([teamId, createdAt])
  @@map("cloud_projects")
}

/// An immutable upload of a built folder.
model CloudDeployment {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  /// The id's first 8 hexadecimal characters: its address `<slug>--<shortId>`.
  shortId     String      @map("short_id") @db.VarChar(8)
  target      CloudTarget
  message     String?     @db.VarChar(200)
  commit      String?     @db.VarChar(40)
  branch      String?     @db.VarChar(100)
  sizeBytes   BigInt      @map("size_bytes")
  fileCount   Int         @map("file_count")
  createdById String?     @map("created_by_id") @db.Uuid
  tokenId     String?     @map("token_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project      CloudProject  @relation("CloudDeployments", fields: [projectId], references: [id], onDelete: Cascade)
  productionOf CloudProject? @relation("CloudProduction")
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  token        CloudToken?   @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([projectId, shortId])
  @@index([projectId, createdAt])
  @@map("cloud_deployments")
}

model CloudDomain {
  id                String           @id @default(uuid()) @db.Uuid
  projectId         String           @map("project_id") @db.Uuid
  name              String           @unique @db.VarChar(253)
  /// The value of the TXT record `_codeqlick.<name>`: `cq-verify=<this>`.
  verificationToken String           @map("verification_token") @db.VarChar(64)
  state             CloudDomainState @default(PENDING)
  verifiedAt        DateTime?        @map("verified_at") @db.Timestamptz(3)
  checkedAt         DateTime?        @map("checked_at") @db.Timestamptz(3)
  lastError         String?          @map("last_error") @db.VarChar(300)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([state, checkedAt])
  @@map("cloud_domains")
}

/// Everything that changed in a team, newest first in the console; kept 365 days.
model CloudEvent {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String   @map("actor_name") @db.VarChar(120)
  /// The token's name when the change came through one.
  tokenName   String?  @map("token_name") @db.VarChar(80)
  action      String   @db.VarChar(60)
  targetLabel String?  @map("target_label") @db.VarChar(300)
  details     Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team  CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([createdAt])
  @@map("cloud_events")
}

/// A public report of a hosted page (abuse, DSA).
model CloudReport {
  id        String            @id @default(uuid()) @db.Uuid
  url       String            @db.VarChar(2048)
  projectId String?           @map("project_id") @db.Uuid
  reason    CloudReportReason
  details   String            @db.VarChar(2000)
  email     String            @db.VarChar(254)
  status    CloudReportStatus @default(OPEN)
  note      String?           @db.VarChar(1000)
  closedAt  DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  project CloudProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("cloud_reports")
}

/// A form of a Cloud project: its pages post to /v1/cloud/forms/<key> (architecture 4.13, Forms).
model CloudForm {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  name           String   @db.VarChar(60)
  /// Public (in the page's HTML): `cqf_` + 16 random bytes; replacing it stops copies of the old one.
  key            String   @unique @db.VarChar(40)
  enabled        Boolean  @default(true)
  /// Email each submission to the recipients.
  notify         Boolean  @default(true)
  /// Team members who get the submissions by email (never typed addresses, decision 37).
  recipientIds   String[] @map("recipient_ids") @db.Uuid
  /// `yyyy-mm` of the month its team was told it ran out of submissions (once a month).
  overLimitMonth String?  @map("over_limit_month") @db.VarChar(7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     CloudProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions CloudFormSubmission[]

  @@index([projectId])
  @@map("cloud_forms")
}

/// What a page sent through a Cloud form; kept 180 days, no IP.
model CloudFormSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  /// The fields as sent (names to values), without the `_` instructions.
  data      Json
  email     String?  @db.VarChar(254)
  /// The page it came from: origin and path only.
  page      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form CloudForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([createdAt])
  @@map("cloud_form_submissions")
}

enum CloudMonitorKind {
  HTTP
  HEARTBEAT
}

enum CloudMonitorStatus {
  UNKNOWN
  UP
  DOWN
  PAUSED
}

/// A URL checked every 5 minutes, or a heartbeat a scheduled job calls (architecture 4.13, Monitors).
model CloudMonitor {
  id              String             @id @default(uuid()) @db.Uuid
  teamId          String             @map("team_id") @db.Uuid
  projectId       String?            @map("project_id") @db.Uuid
  name            String             @db.VarChar(60)
  kind            CloudMonitorKind
  url             String?            @db.VarChar(2048)
  /// Heartbeats: `cqh_` + 16 random bytes, the URL's last part.
  key             String?            @unique @db.VarChar(40)
  periodMinutes   Int?               @map("period_minutes")
  graceMinutes    Int?               @map("grace_minutes")
  enabled         Boolean            @default(true)
  status          CloudMonitorStatus @default(UNKNOWN)
  statusSince     DateTime           @default(now()) @map("status_since") @db.Timestamptz(3)
  /// HTTP: failed checks in a row (DOWN after two).
  failures        Int                @default(0)
  lastCheckedAt   DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  lastPingAt      DateTime?          @map("last_ping_at") @db.Timestamptz(3)
  /// Heartbeats: when it is late without a call.
  deadlineAt      DateTime?          @map("deadline_at") @db.Timestamptz(3)
  lastError       String?            @map("last_error") @db.VarChar(300)
  certExpiresAt   DateTime?          @map("cert_expires_at") @db.Timestamptz(3)
  certCheckedAt   DateTime?          @map("cert_checked_at") @db.Timestamptz(3)
  certWarnedFor   DateTime?          @map("cert_warned_for") @db.Timestamptz(3)
  /// Team members told by email when it goes down or comes back.
  alertIds        String[]           @map("alert_ids") @db.Uuid
  lastDownAlertAt DateTime?          @map("last_down_alert_at") @db.Timestamptz(3)
  lastUpAlertAt   DateTime?          @map("last_up_alert_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  team   CloudTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  checks CloudMonitorCheck[]
  events CloudMonitorEvent[]

  @@index([teamId])
  @@index([kind, enabled, lastCheckedAt])
  @@index([kind, enabled, deadlineAt])
  @@map("cloud_monitors")
}

/// One HTTP check, or one heartbeat call; kept 90 days.
model CloudMonitorCheck {
  id         String   @id @default(uuid()) @db.Uuid
  monitorId  String   @map("monitor_id") @db.Uuid
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  ok         Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  error      String?  @db.VarChar(300)

  monitor CloudMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@index([checkedAt])
  @@map("cloud_monitor_checks")
}

/// A change of a monitor's state: the incident history and what uptime is measured from.
model CloudMonitorEvent {
  id        String             @id @default(uuid()) @db.Uuid
  monitorId String             @map("monitor_id") @db.Uuid
  status    CloudMonitorStatus
  at        DateTime           @default(now()) @db.Timestamptz(3)
  error     String?            @db.VarChar(300)

  monitor CloudMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, at])
  @@map("cloud_monitor_events")
}

/// A team's public status page (cloud.codeqlick.com/<locale>/status/<team>).
model CloudStatusPage {
  teamId    String   @id @map("team_id") @db.Uuid
  enabled   Boolean  @default(false)
  title     String   @db.VarChar(80)
  intro     String?  @db.VarChar(500)
  /// `[{ monitorId, label }]` in the order shown.
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("cloud_status_pages")
}

/// A website check run through Cloud's API (architecture 4.13, Website check API); kept 30 days.
model CloudAudit {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  url       String   @db.VarChar(2048)
  score     Int
  /// The checks' result as the free website check stores it (final URL, categories, checks).
  result    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([createdAt])
  @@map("cloud_audits")
}

/// A GitHub App installation linked to a team (architecture 4.13, Builds from Git; decision 40).
model CloudGitInstallation {
  id             String    @id @default(uuid()) @db.Uuid
  installationId BigInt    @unique @map("installation_id")
  teamId         String    @map("team_id") @db.Uuid
  accountLogin   String    @map("account_login") @db.VarChar(100)
  accountType    String    @map("account_type") @db.VarChar(20)
  createdById    String?   @map("created_by_id") @db.Uuid
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team CloudTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("cloud_git_installations")
}

/// A build variable of a project: sealed, never returned (decision 42).
model CloudEnvVar {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  key         String   @db.VarChar(64)
  valueSealed String   @map("value_sealed")
  production  Boolean  @default(true)
  preview     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("cloud_env_vars")
}

enum CloudNotifyKind {
  EMAIL
  SLACK
  DISCORD
  WEBHOOK
}

/// Where a project's build results go (architecture 4.13 "Build notifications", decision 43).
model CloudNotifyChannel {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  name           String          @db.VarChar(60)
  kind           CloudNotifyKind
  enabled        Boolean         @default(true)
  /// Slack, Discord and webhook URLs, sealed (purpose cloud-notify-v1).
  urlSealed      String?         @map("url_sealed")
  /// What the console shows of the URL: its host and last 4 characters.
  urlHint        String?         @map("url_hint") @db.VarChar(120)
  /// A webhook's signing secret, sealed.
  secretSealed   String?         @map("secret_sealed")
  recipientIds   String[]        @map("recipient_ids") @db.Uuid
  buildFailed    Boolean         @default(true) @map("build_failed")
  buildSucceeded Boolean         @default(false) @map("build_succeeded")
  previews       Boolean         @default(false)
  /// The language of Slack, Discord and webhook messages (`en` or `es`).
  locale         String          @default("en") @db.VarChar(2)
  /// Failed deliveries in a row; ten switch the channel off.
  failures       Int             @default(0)
  lastSentAt     DateTime?       @map("last_sent_at") @db.Timestamptz(3)
  lastOk         Boolean?        @map("last_ok")
  lastError      String?         @map("last_error") @db.VarChar(300)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("cloud_notify_channels")
}

enum CloudBuildTrigger {
  PUSH
  PULL_REQUEST
  MANUAL
}

enum CloudBuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// A build of a project's commit on the build server (architecture 4.13, 8.4).
model CloudBuild {
  id            String            @id @default(uuid()) @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  /// 1, 2, 3… per project: the console's address of the build.
  number        Int
  trigger       CloudBuildTrigger
  target        CloudTarget
  branch        String            @db.VarChar(200)
  commit        String            @db.VarChar(40)
  commitMessage String?           @map("commit_message") @db.VarChar(500)
  author        String?           @db.VarChar(100)
  pullRequest   Int?              @map("pull_request")
  status        CloudBuildStatus  @default(QUEUED)
  error         String?           @db.VarChar(500)
  /// stdout and stderr, at most 1 MB (the end is kept); emptied after 30 days.
  log           String            @default("")
  deploymentId  String?           @map("deployment_id") @db.Uuid
  builder       String?           @db.VarChar(60)
  createdById   String?           @map("created_by_id") @db.Uuid
  queuedAt      DateTime          @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt     DateTime?         @map("started_at") @db.Timestamptz(3)
  heartbeatAt   DateTime?         @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt    DateTime?         @map("finished_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([status, queuedAt])
  @@index([projectId, queuedAt])
  @@map("cloud_builds")
}

/// A GitHub webhook delivery already handled (kept a day).
model CloudGitDelivery {
  id         String   @id @db.VarChar(64)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt])
  @@map("cloud_git_deliveries")
}

/// The app's comment on a pull request, updated by each build.
model CloudPullComment {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  pullRequest Int    @map("pull_request")
  commentId   BigInt @map("comment_id")

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pullRequest])
  @@map("cloud_pull_comments")
}

/// A page view or custom event of a project's site (architecture 4.13 "Web analytics", decision 44).
/// No IP, cookie or anything that follows a person from one day to the next.
model CloudAnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  projectId String   @map("project_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  /// `pageview` or the site's custom event.
  name      String   @db.VarChar(40)
  path      String   @db.VarChar(300)
  /// The referring site's host, when it is another site.
  referrer  String?  @db.VarChar(100)
  /// `utm_source` or `ref` of the page's address.
  campaign  String?  @db.VarChar(60)
  browser   String   @db.VarChar(20)
  os        String   @db.VarChar(20)
  device    String   @db.VarChar(10)
  /// SHA-256 of the day's salt, the project, the IP and the User-Agent (first 16 bytes, hex).
  visitor   String   @db.Char(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([teamId, createdAt])
  @@map("cloud_analytics_events")
}

/// The salt of one UTC day's visitor ids; deleted the day after (decision 44).
model CloudAnalyticsSalt {
  day       String   @id @db.VarChar(10)
  salt      String   @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("cloud_analytics_salts")
}

/// An entry of a project's key-value store (architecture 4.13 "Key-value store", decision 45).
model CloudKvEntry {
  projectId String    @map("project_id") @db.Uuid
  key       String    @db.VarChar(256)
  value     Json
  /// Bytes of the value serialised as JSON.
  size      Int
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project CloudProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, key])
  @@index([expiresAt])
  @@map("cloud_kv_entries")
}
