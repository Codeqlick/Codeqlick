// Codeqlick data model. See docs/architecture.md section 4.2.
// The connection URL lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum Locale {
  EN
  ES
}

/// The sales process (wiki: Client Engagement): first contact, talking, discovery call, proposal,
/// then won or lost. SPAM is not a stage: it takes noise off the board.
enum LeadStatus {
  NEW
  TALKING
  CALL
  PROPOSAL
  WON
  LOST
  SPAM
}

enum LeadLostReason {
  PRICE
  NO_RESPONSE
  NOT_A_FIT
  CHOSE_OTHER
  TIMING
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

/// Where a release went: the preview (staging) or the live site.
enum ReleaseEnvironment {
  STAGING
  PRODUCTION
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  LAUNCHED
  SUPPORT
  ON_HOLD
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  role               Role      @default(CLIENT)
  isActive           Boolean   @default(true) @map("is_active")
  /// Language of the emails the platform sends this user (welcome, project updates).
  locale             Locale    @default(EN)
  /// Two-step verification: the authenticator secret, encrypted (see secret-box.ts). Set while
  /// setting it up; it only counts once `totpEnabledAt` is set.
  totpSecret         String?   @map("totp_secret")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted time step, so a code can't be used twice.
  totpLastStep       Int?      @map("totp_last_step")
  /// SHA-256 of each unused recovery code.
  totpRecoveryHashes String[]  @default([]) @map("totp_recovery_hashes")
  /// Clients get a Monday summary of their projects unless they turn it off.
  weeklyDigest       Boolean   @default(true) @map("weekly_digest")
  /// When the last summary went out, so each client gets one per week even across restarts.
  lastDigestAt       DateTime? @map("last_digest_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  passwordResets  PasswordResetToken[]
  clientProjects  ClientProject[]
  posts           Post[]
  projectUpdates  ProjectUpdate[]        @relation("ProjectUpdateAuthor")
  approvedUpdates ProjectUpdate[]        @relation("ProjectUpdateApprover")
  updateComments  ProjectUpdateComment[]
  leadsConverted  Lead[]                 @relation("LeadClient")
  tickets         SupportTicket[]
  ticketMessages  TicketMessage[]
  ticketFiles     TicketAttachment[]
  proposals       Proposal[]             @relation("ProposalClient")
  proposalsMade   Proposal[]             @relation("ProposalAuthor")
  timeEntries     TimeEntry[]
  credentials     ProjectCredential[]
  /// A person of a client company: they see and act on the account of `memberOf` (the company's
  /// main client account), which owns the projects, requests and proposals.
  memberOfId      String?                @map("member_of_id") @db.Uuid
  memberOf        User?                  @relation("ClientTeam", fields: [memberOfId], references: [id], onDelete: Cascade)
  members         User[]                 @relation("ClientTeam")
  projectFiles    ProjectFile[]
  activity        ActivityLog[]
  leadReplies     LeadReply[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// One row per "forgot my password" email. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Lead {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  email       String
  company     String?
  budget      String?
  /// What they need (web, custom, mobile, design, support, not-sure); replaced budget on the form.
  projectType String?         @map("project_type")
  message     String
  locale      Locale          @default(EN)
  status      LeadStatus      @default(NEW)
  notes       String?
  /// Why it didn't go ahead (status LOST).
  lostReason  LeadLostReason? @map("lost_reason")
  /// When to get back to them; the board flags it once it has passed.
  followUpOn  DateTime?       @map("follow_up_on") @db.Date
  /// The client account it became ("Convert to client").
  clientId    String?         @map("client_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  replies  LeadReply[]
  client   User?       @relation("LeadClient", fields: [clientId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([status, createdAt])
  @@map("leads")
}

/// An email answer sent to a lead from the admin panel. Only stored once the email went out.
model LeadReply {
  id         String   @id @default(uuid()) @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  /// Copied at the time, so the history keeps it after the author's account is deleted.
  authorName String   @map("author_name")
  subject    String
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_replies")
}

model Post {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  status        PublishStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  coverImageUrl String?       @map("cover_image_url")
  authorId      String?       @map("author_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  author       User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations PostTranslation[]
  tags         PostTag[]

  @@index([status, publishedAt])
  @@map("posts")
}

/// A blog topic, shared by both languages: one slug for URLs, a name per language.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameEs    String   @map("name_es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model PostTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  locale    Locale
  title     String
  excerpt   String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@map("post_translations")
}

model PortfolioItem {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  status            PublishStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  coverImageUrl     String?       @map("cover_image_url")
  clientName        String?       @map("client_name")
  projectUrl        String?       @map("project_url")
  technologies      String[]
  /// Service lines the work covered (the website's service keys: web, custom, mobile, design...).
  services          String[]      @default([])
  sortOrder         Int           @default(0) @map("sort_order")
  /// Who gave the testimonial; the quote and their role are per language (translations).
  testimonialAuthor String?       @map("testimonial_author")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations PortfolioTranslation[]

  @@index([status, sortOrder])
  @@map("portfolio_items")
}

model PortfolioTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  portfolioItemId  String   @map("portfolio_item_id") @db.Uuid
  locale           Locale
  title            String
  summary          String
  content          String
  testimonialQuote String?  @map("testimonial_quote")
  testimonialRole  String?  @map("testimonial_role")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, locale])
  @@map("portfolio_translations")
}

model ClientProject {
  id                    String       @id @default(uuid()) @db.Uuid
  clientId              String       @map("client_id") @db.Uuid
  name                  String
  description           String?
  phase                 ProjectPhase @default(DISCOVERY)
  progress              Int          @default(0)
  startDate             DateTime?    @map("start_date") @db.Timestamptz(3)
  dueDate               DateTime?    @map("due_date") @db.Timestamptz(3)
  stagingUrl            String?      @map("staging_url")
  productionUrl         String?      @map("production_url")
  /// The client sees the hours logged on it (a monthly summary and the entries) in the portal.
  showHours             Boolean      @default(false) @map("show_hours")
  /// SHA-256 of the project's release key, which a deploy pipeline uses to publish releases.
  releaseTokenHash      String?      @unique @map("release_token_hash")
  releaseTokenCreatedAt DateTime?    @map("release_token_created_at") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client      User                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  updates     ProjectUpdate[]
  files       ProjectFile[]
  milestones  ProjectMilestone[]
  tickets     SupportTicket[]
  proposals   Proposal[]
  time        TimeEntry[]
  drafts      UpdateDraft[]
  tasks       ProjectTask[]
  brief       ProjectBrief?
  monitor     SiteMonitor?
  credentials ProjectCredential[]
  review      ClientReview?
  plan        MaintenancePlan?

  @@index([clientId])
  @@map("client_projects")
}

/// A step of a client project the client sees on a timeline, in `position` order.
model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

/// A comment on a project update, by the client or the team.
model ProjectUpdateComment {
  id        String   @id @default(uuid()) @db.Uuid
  updateId  String   @map("update_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  update ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([updateId, createdAt])
  @@map("project_update_comments")
}

model ProjectUpdate {
  id                String              @id @default(uuid()) @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  authorId          String?             @map("author_id") @db.Uuid
  title             String
  body              String
  /// The client is asked to approve it; `approvedAt` is set when they do.
  approvalRequested Boolean             @default(false) @map("approval_requested")
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedById      String?             @map("approved_by_id") @db.Uuid
  /// A release: the version deployed, where, and its address. Null on plain updates.
  version           String?
  environment       ReleaseEnvironment?
  url               String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    ClientProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User?                  @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedBy User?                  @relation("ProjectUpdateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  comments   ProjectUpdateComment[]

  @@index([projectId, createdAt])
  @@map("project_updates")
}

/// A file shared with the client of a project (deliverables, documents). The content lives on disk
/// under UPLOADS_DIR/project-files/<id>; only signed-in users who can see the project download it.
model ProjectFile {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  /// The original file name, cleaned up; used when downloading.
  name         String
  /// As sent by the uploader's browser. Informational only: downloads are always attachments.
  contentType  String   @map("content_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_files")
}

/// Who changed what: one row per change made from the admin panel or to one's own account.
/// Actor name and target label are copied at the time, so entries survive renames and deletes.
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String   @map("actor_name")
  /// `<target>.<verb>`, e.g. `post.published` (see ACTIVITY_ACTIONS in the activity module).
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  /// Extra facts about the change, e.g. `{ "status": "WON" }` or the fields that changed.
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, createdAt])
  @@map("activity_log")
}

/// A reusable text for lead replies and project comments; `{name}` and `{project}` are filled in
/// by the admin panel when it is inserted.
model SavedReply {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("saved_replies")
}

enum TicketType {
  BUG
  CHANGE
  QUESTION
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

/// A support request a client opens from the portal: a bug, a change or a question.
model SupportTicket {
  id         String         @id @default(uuid()) @db.Uuid
  /// Short reference shown to people (#12).
  number     Int            @unique @default(autoincrement())
  clientId   String         @map("client_id") @db.Uuid
  projectId  String?        @map("project_id") @db.Uuid
  type       TicketType
  priority   TicketPriority @default(NORMAL)
  status     TicketStatus   @default(OPEN)
  title      String
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client   User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages TicketMessage[]
  files    TicketAttachment[]
  tasks    ProjectTask[]

  @@index([status, updatedAt])
  @@index([clientId, updatedAt])
  @@map("support_tickets")
}

/// A message in a support request's conversation; the first one is the description.
model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// A file added to a support request by the client or the team (a screenshot, a log...). Stored
/// on disk at UPLOADS_DIR/ticket-files/<id>, like project files.
model TicketAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  name         String
  contentType  String   @map("content_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_attachments")
}

/// DRAFT: only the team sees it. SENT: the client can accept or decline it (until `validUntil`).
/// WITHDRAWN: the team took it back after sending it.
enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// A proposal or quote for a client: what will be done, item by item with prices, and the terms.
model Proposal {
  id            String         @id @default(uuid()) @db.Uuid
  /// Short reference shown to people (#7).
  number        Int            @unique @default(autoincrement())
  clientId      String         @map("client_id") @db.Uuid
  projectId     String?        @map("project_id") @db.Uuid
  createdById   String?        @map("created_by_id") @db.Uuid
  title         String
  /// Markdown: the scope, what is included and what isn't.
  summary       String
  /// Markdown: payment schedule, deadlines, conditions.
  terms         String?
  currency      String         @default("EUR")
  /// Last day the client can accept it.
  validUntil    DateTime?      @map("valid_until") @db.Date
  status        ProposalStatus @default(DRAFT)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  respondedAt   DateTime?      @map("responded_at") @db.Timestamptz(3)
  /// The full name the client typed to accept it.
  acceptedName  String?        @map("accepted_name")
  declineReason String?        @map("decline_reason")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client    User           @relation("ProposalClient", fields: [clientId], references: [id], onDelete: Cascade)
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("ProposalAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items     ProposalItem[]

  @@index([status, updatedAt])
  @@index([clientId, updatedAt])
  @@map("proposals")
}

/// A line of a proposal; amounts in cents.
model ProposalItem {
  id          String @id @default(uuid()) @db.Uuid
  proposalId  String @map("proposal_id") @db.Uuid
  position    Int
  description String
  quantity    Int
  unitPrice   Int    @map("unit_price")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, position])
  @@map("proposal_items")
}

/// Time spent on a client project: who, which day (Madrid), how long and on what.
model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  date        DateTime @db.Date
  minutes     Int
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([date])
  @@map("time_entries")
}

/// An update prepared outside the panel (a deploy pipeline, a summary of the work done) waiting for
/// the team to review it. Publishing it creates the ProjectUpdate and removes the draft.
model UpdateDraft {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @map("project_id") @db.Uuid
  title       String
  body        String
  /// Set when it is a release.
  version     String?
  environment ReleaseEnvironment?
  url         String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("update_drafts")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Work to do on a client project: a change the client asked for (from a support request) or one
/// the team planned. The client sees titles and statuses; the description is for the team.
model ProjectTask {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  /// The support request it came from, when it did.
  ticketId    String?    @map("ticket_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  doneAt      DateTime?  @map("done_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket  SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ticketId])
  @@map("project_tasks")
}

/// Site settings edited in the admin panel, one JSON document per key (e.g. `calculator`).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// A video call booked from the website in one of the team's free slots.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  email           String
  company         String?
  message         String?
  locale          Locale        @default(EN)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  status          BookingStatus @default(CONFIRMED)
  /// The start while confirmed, null once cancelled: two confirmed calls can't share a start.
  slotKey         DateTime?     @unique @map("slot_key") @db.Timestamptz(3)
  /// SHA-256 of the token in the visitor's cancel link.
  cancelTokenHash String        @unique @map("cancel_token_hash")
  /// Calendar invitation revision (bumped when it is cancelled).
  sequence        Int           @default(0)
  leadId          String?       @map("lead_id") @db.Uuid
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@map("bookings")
}

enum BriefStatus {
  REQUESTED
  SUBMITTED
}

/// The client's answers to the project questionnaire (goals, audience, must-haves, brand...), one
/// per project. Saved as they go (REQUESTED) until they send it (SUBMITTED); they can edit it after.
model ProjectBrief {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @unique @map("project_id") @db.Uuid
  status      BriefStatus @default(REQUESTED)
  /// The answers, by question key (see briefs.schemas.ts).
  answers     Json        @default("{}")
  requestedAt DateTime    @default(now()) @map("requested_at") @db.Timestamptz(3)
  submittedAt DateTime?   @map("submitted_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_briefs")
}

enum SiteStatus {
  UNKNOWN
  UP
  DOWN
}

/// Uptime monitoring of a client project's production site (its `productionUrl`).
model SiteMonitor {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @unique @map("project_id") @db.Uuid
  enabled       Boolean    @default(true)
  status        SiteStatus @default(UNKNOWN)
  /// When the current status started.
  statusSince   DateTime   @default(now()) @map("status_since") @db.Timestamptz(3)
  /// Failed checks in a row (DOWN after two).
  failures      Int        @default(0)
  lastCheckedAt DateTime?  @map("last_checked_at") @db.Timestamptz(3)
  lastError     String?    @map("last_error")
  certExpiresAt DateTime?  @map("cert_expires_at") @db.Timestamptz(3)
  certCheckedAt DateTime?  @map("cert_checked_at") @db.Timestamptz(3)
  /// The certificate expiry the team was last warned about (once per certificate).
  certWarnedFor DateTime?  @map("cert_warned_for") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  SiteCheck[]

  @@map("site_monitors")
}

/// One check of a monitored site; kept 90 days.
model SiteCheck {
  id         String   @id @default(uuid()) @db.Uuid
  monitorId  String   @map("monitor_id") @db.Uuid
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  ok         Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  error      String?

  monitor SiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("site_checks")
}

/// Access the client shares for their project (hosting, domain, a service account), encrypted at
/// rest (AES-256-GCM, CREDENTIALS_SECRET). Clients can add and delete; only the team reads the
/// secret, and every read is logged.
model ProjectCredential {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  label       String
  url         String?
  username    String?
  /// Sealed (see secret-box.ts).
  secret      String
  /// Sealed too, when given.
  notes       String?
  /// When the team last revealed it.
  viewedAt    DateTime? @map("viewed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_credentials")
}

enum ReviewStatus {
  REQUESTED
  SUBMITTED
  PUBLISHED
  HIDDEN
}

/// The client's rating and words about a finished project. Asked for when it is launched; it goes
/// on the website only with their consent and once the team publishes it.
model ClientReview {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @unique @map("project_id") @db.Uuid
  status      ReviewStatus @default(REQUESTED)
  /// 1 to 5.
  rating      Int?
  quote       String?
  authorName  String?      @map("author_name")
  /// Their role and company, e.g. "CEO, Clínica Sol".
  authorRole  String?      @map("author_role")
  /// They allow it on the website.
  consent     Boolean      @default(false)
  /// The language they wrote it in (it shows on the site in that language).
  locale      Locale       @default(EN)
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  submittedAt DateTime?    @map("submitted_at") @db.Timestamptz(3)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@map("client_reviews")
}

/// A monthly hour allowance for a project (maintenance and support), drawn down by its time
/// entries per Madrid calendar month. The team is warned at `alertPercent` and at 100 %.
model MaintenancePlan {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  active         Boolean  @default(true)
  name           String
  monthlyMinutes Int      @map("monthly_minutes")
  alertPercent   Int      @default(80) @map("alert_percent")
  /// The last month (`yyyy-mm`) and level (alertPercent or 100) the team was warned about.
  alertedMonth   String?  @map("alerted_month")
  alertedLevel   Int      @default(0) @map("alerted_level")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("maintenance_plans")
}
