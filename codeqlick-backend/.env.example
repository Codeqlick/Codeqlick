# Copy to .env for local development: cp .env.example .env
# Local infrastructure (PostgreSQL + Mailpit) comes from the repository's docker-compose.yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://codeqlick:codeqlick@localhost:5432/codeqlick

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change-me
# Access token lifetime in seconds
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Mailpit in development (web inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Codeqlick <hello@codeqlick.com>
LEADS_NOTIFY_TO=hello@codeqlick.com

# Folder for images uploaded from the admin panel
UPLOADS_DIR=./uploads

# Only used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@codeqlick.com
SEED_ADMIN_PASSWORD=change-me-please-123
SEED_ADMIN_NAME=Codeqlick Admin
