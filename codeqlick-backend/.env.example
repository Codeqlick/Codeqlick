# Copy to .env for local development: cp .env.example .env
# Local infrastructure (PostgreSQL + Mailpit) comes from the repository's docker-compose.yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://codeqlick:codeqlick@localhost:5432/codeqlick

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Public URL of the website (links in emails)
SITE_URL=http://localhost:3000

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change-me
# Encrypts the access clients share (project credentials); unset, derived from JWT_ACCESS_SECRET.
# CREDENTIALS_SECRET=
# Access token lifetime in seconds
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Mailpit in development (web inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Codeqlick <hello@codeqlick.com>
LEADS_NOTIFY_TO=hello@codeqlick.com

# Folder for images uploaded from the admin panel
# Admins need two-step verification for admin routes (true in production)
# ADMIN_TWO_FACTOR_REQUIRED=false
# Umami's API, for the dashboard's visits (optional)
# UMAMI_URL=http://localhost:3020
# UMAMI_WEBSITE_ID=
# UMAMI_USERNAME=admin
# UMAMI_PASSWORD=
# The site builder (codeqlick-sites), for managed client sites (optional)
# SITE_BUILDER_URL=http://localhost:4100
# SITE_BUILDER_TOKEN=dev-site-builder-token
# SITES_PREVIEW_DOMAIN=demo.codeqlick.com
# PUBLIC_API_URL=http://localhost:4000/v1
# Client domains: the server IP they point at, and OVH's API (optional)
# SITES_SERVER_IP=
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# OVH_NIC_HANDLE=
UPLOADS_DIR=./uploads

# Only used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@codeqlick.com
SEED_ADMIN_PASSWORD=change-me-please-123
SEED_ADMIN_NAME=Codeqlick Admin
