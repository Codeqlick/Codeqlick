# Production settings for docker-compose.prod.yml. Copy to /srv/codeqlick/.env and fill in.
# Never commit the real file.

# Public URL of the website, without a trailing slash.
SITE_URL=https://codeqlick.com

# Database password. Letters and digits only (it is embedded in a connection URL).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Encrypts the access clients share for their projects (openssl rand -base64 48). Keep it: changing
# it makes the stored access unreadable.
CREDENTIALS_SECRET=

# Outgoing email (contact form notifications and acknowledgements).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Codeqlick <hello@codeqlick.com>
LEADS_NOTIFY_TO=hello@codeqlick.com

# Admin accounts need two-step verification to use the admin panel (default true). Until they turn
# it on they only reach their account page, which has the setup.
ADMIN_TWO_FACTOR_REQUIRED=true

# Loopback ports the host's Nginx proxies to (3000 and 3001 belong to another project on the VPS).
# If you change them, update deploy/nginx/*.conf to match.
WEB_PORT=3010
API_PORT=4010

# Daily database dumps (the `backup` service). BACKUP_USER is the `uid:gid` that owns the files:
# use the output of `id -u` and `id -g` for the deploy user. Create BACKUP_DIR before the first
# start, otherwise Docker creates it as root and the dumps can't be written.
BACKUP_USER=1000:1000
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Analytics (Umami, cookieless). Generate both with: openssl rand -hex 24
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# The website's id in Umami (Settings → Websites); empty until it exists, then rebuild the web.
UMAMI_WEBSITE_ID=
# Password of Umami's `admin` user (set it after the first login): the API reads the visit
# numbers shown on the admin dashboard with it.
UMAMI_ADMIN_PASSWORD=
# Loopback port of Umami's dashboard.
UMAMI_PORT=3020

# Legal notice and privacy policy (/legal, /privacy): hidden, with their links, until the owner's
# name is set. The tax id and address are optional. Deploy after changing them (pages are rebuilt).
LEGAL_OWNER_NAME=
LEGAL_OWNER_TAX_ID=
LEGAL_OWNER_ADDRESS=

# Managed client sites (codeqlick-sites): the builder writes them to /srv/codeqlick/sites as this
# user (the deploy user's uid:gid, `id -u`:`id -g`), and the API calls it with this token
# (`openssl rand -hex 32`). Previews are served at <slug>.SITES_PREVIEW_DOMAIN.
SITES_USER=
SITE_BUILDER_TOKEN=
SITES_PREVIEW_DOMAIN=demo.codeqlick.com

# Client domains (architecture 11): the server's public IPv4 (their A records point here) and
# OVH's API with the team's keys (https://eu.api.ovh.com/createToken/, rights in deploy/README.md)
# and account ID, which clients make the technical contact of their domain. Optional.
SITES_SERVER_IP=54.37.159.171
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_NIC_HANDLE=

# Buying a preview online with Stripe Checkout (architecture 8.2, decision 20): Codeqlick's Stripe
# account (live keys). Off while empty; steps in deploy/README.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Codeqlick Cloud's PRO plan (architecture 4.13, decision 46): the id (price_…) of a recurring
# monthly price made in Stripe's dashboard. Paid plans are off while it is empty.
STRIPE_CLOUD_PRO_PRICE_ID=
# Price of a basic website bought online, in euro cents before VAT, and the VAT added to it.
SITE_PRICE_CENTS=20000
SITE_VAT_PERCENT=21

# Video chat at videochat.codeqlick.com (architecture 4.7; deploy/README.md, "Video chat"). coturn's
# shared secret (`openssl rand -hex 32`) and the STUN/TURN URLs given to browsers. Explicit content
# between adults is allowed; set the last one to true to require a verified age (not only declared).
VIDEOCHAT_URL=https://videochat.codeqlick.com
TURN_SECRET=
TURN_URLS=stun:videochat.codeqlick.com:3478,turn:videochat.codeqlick.com:3478?transport=udp,turn:videochat.codeqlick.com:3478?transport=tcp
VIDEOCHAT_AGE_VERIFICATION_REQUIRED=false
# Meetings at meetings.codeqlick.com (architecture 4.8; deploy/README.md, "Meetings"): the page
# allowed to open its WebSocket. Calls use the video chat's coturn above.
MEETINGS_URL=https://meetings.codeqlick.com
# "Someone is waiting" notifications (Web Push); off while empty. deploy/deploy.sh creates them on
# the next release when they are missing, or by hand: docker compose -f docker-compose.prod.yml exec api node --input-type=module \
#   -e "import w from 'web-push'; console.log(w.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Turns coturn on (deploy/setup-videochat.sh sets it); add other Compose profiles comma-separated.
COMPOSE_PROFILES=videochat

LOG_LEVEL=info

# Cloudflare Turnstile against bots on sign-up and sign-in (architecture 4.3; deploy/README.md,
# "Turnstile"). Off while empty. Kept in GitHub's Actions secrets of the same names: every release
# writes them here (deploy/ci-deploy.sh), so they don't need to be typed on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google PageSpeed Insights (free key, Google Cloud console → APIs → PageSpeed Insights API):
# adds Google's mobile speed to the free website check (architecture 4.12). Optional.
PAGESPEED_API_KEY=

# Codeqlick Cloud's managed databases (architecture 4.13 "Databases", decision 47): cloud-pg runs
# with the cloud-data profile. Password: `openssl rand -hex 32`. Off while CLOUD_PG_HOST is empty.
# COMPOSE_PROFILES=cloud-data
CLOUD_PG_PASSWORD=
CLOUD_PG_HOST=
