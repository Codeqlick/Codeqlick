# Staging settings for docker-compose.staging.yml. Copy to /srv/codeqlick-staging/.env and fill in.
# Never commit the real file. Use secrets of its own, not production's.

SITE_URL=https://staging.codeqlick.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 48 (each)
JWT_ACCESS_SECRET=
CREDENTIALS_SECRET=

# Loopback ports, next to production's 3010/4010.
WEB_PORT=3011
API_PORT=4011
MAILPIT_PORT=8026

# Same as production, so the legal pages show.
LEGAL_OWNER_NAME=
LEGAL_OWNER_TAX_ID=
LEGAL_OWNER_ADDRESS=
