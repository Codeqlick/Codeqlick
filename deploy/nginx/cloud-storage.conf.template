# Codeqlick Cloud's object storage (architecture 4.13 "Object storage", decision 48):
# https://s3.__DOMAIN__ is Garage's S3 API (path-style), with the hosting domain's wildcard
# certificate. An exact server_name wins over cloud-hosting.conf's regular expression.
# Rendered and installed by deploy/setup-storage.sh as /etc/nginx/sites-available/cloud-storage.conf.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name s3.__DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Uploads stream to Garage: no size limit here (each bucket has its quota), no buffering.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        # S3 signatures cover the Host header: it must reach Garage as the client sent it.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:3900;
    }
}
