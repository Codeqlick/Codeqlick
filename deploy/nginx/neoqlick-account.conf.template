# Neoqlick's account host (architecture 4.18, 6.5): the website serves every address, without the
# apps' /ws. Rendered by deploy/setup-neoqlick.sh. HTTP only on purpose: `certbot --nginx` adds the
# TLS listener and the redirect. Installed as /etc/nginx/sites-available/account.neoqlick.com.conf.

server {
    listen 80;
    listen [::]:80;
    server_name account.neoqlick.com;
    # HTTP/2 on the TLS listener certbot adds (nginx >= 1.25).
    http2 on;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
