# Codeqlick Cloud's hosting (architecture 8.3): every <label>.__DOMAIN__ serves
# /srv/codeqlick/cloud/hosts/<label>, a link the API points at a deployment (or at the
# "suspended" page). One wildcard certificate; deploying never reloads Nginx.
# Rendered and installed by deploy/setup-cloud.sh as /etc/nginx/sites-available/cloud-hosting.conf.

limit_req_zone $host zone=cq_cloud_host:10m rate=50r/s;

map $cq_label $cq_noindex {
    "~--" "noindex";
    default "";
}

# Password protection (architecture 4.13, 8.3; deploy/nginx/cloud-protection.conf). The project's
# slug and the kind of address from the label: `previews` for <slug>--<short>, `production`
# otherwise. Custom domains' sites (cq-site ... cloud) set both themselves with `set`.
map $cq_label $cq_slug {
    "~^(.+)--[0-9a-f]{8}$" $1;
    default $cq_label;
}

map $cq_label $cq_kind {
    "~--[0-9a-f]{8}$" previews;
    default production;
}

# Only the access cookie of the visitor goes to the API, never the site's other cookies. Also
# used by the custom domains' sites, like the cache and the zone below.
map $http_cookie $cq_access {
    "~(?:^|;)\s*__Host-cq_access=([^;]*)" $1;
    default "";
}

proxy_cache_path /var/cache/nginx/cq-protect levels=1:2 keys_zone=cq_protect:10m max_size=64m inactive=10m use_temp_path=off;
limit_req_zone $binary_remote_addr zone=cq_cloud_password:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ *.__DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name "~^(?<cq_label>[a-z0-9]+(?:-[a-z0-9]+)*(?:--[0-9a-f]{8})?)\.__DOMAIN_RE__$";

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    root /srv/codeqlick/cloud/hosts/$cq_label;
    index index.html;
    disable_symlinks off;
    limit_req zone=cq_cloud_host burst=100 nodelay;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag $cq_noindex always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

    # Password protection: auth_request for every location below, /__cq_check and /__codeqlick/.
    include /etc/nginx/snippets/cq-cloud-protection.conf;

    error_page 404 /404.html;
    error_page 451 @cq_suspended;

    location / {
        if (-f $document_root/.cq-suspended) { return 451; }
        # No site at this address: 410 here, answered as 404 with "nothing here" (below).
        if (!-d $document_root) { return 410; }
        try_files $uri $uri.html $uri/ /200.html =404;
    }

    # Hashed file names: cached for a year. HTML and the rest are revalidated.
    location ~ ^/(?:_astro|assets|_next/static)/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Robots-Tag $cq_noindex always;
        if (-f $document_root/.cq-suspended) { return 451; }
        if (!-d $document_root) { return 410; }
        try_files $uri =404;
    }

    # The site's own 404.html (protected like the rest); without one, "nothing here" when the address has no site and
    # "page not found" when it has.
    location = /404.html {
        internal;
        try_files /404.html @cq_notfound;
    }

    error_page 410 =404 @cq_missing;

    location @cq_missing {
        auth_request off;
        root /srv/codeqlick/cloud/pages/missing;
        try_files /index.html =404;
    }

    location @cq_notfound {
        auth_request off;
        root /srv/codeqlick/cloud/pages/notfound;
        try_files /index.html =404;
    }

    location @cq_suspended {
        auth_request off;
        root /srv/codeqlick/cloud/pages/suspended;
        try_files /index.html =404;
    }
}

# Anything else under the domain (the bare domain, bad labels): the "nothing here" page. A regex,
# not *.__DOMAIN__: Nginx prefers wildcard names over regexes, and this must come after the one above.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__ "~^.+\.__DOMAIN_RE__$";

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    root /srv/codeqlick/cloud/pages/missing;
    error_page 404 /index.html;
    location = /index.html {
        internal;
        add_header X-Robots-Tag noindex always;
    }
    location / {
        return 404;
    }
}
