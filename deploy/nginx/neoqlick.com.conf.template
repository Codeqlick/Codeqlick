# Neoqlick's portal (architecture 4.18): neoqlick.com, with www redirecting to the apex. Rendered
# by deploy/setup-neoqlick.sh (@WEB_PORT@ comes from .env). HTTP only on purpose: `certbot --nginx`
# adds the TLS listener and the redirect. Installed as
# /etc/nginx/sites-available/neoqlick.com.conf.

server {
    listen 80;
    listen [::]:80;
    server_name www.neoqlick.com;
    # HTTP/2 on the TLS listener certbot adds (nginx >= 1.25).
    http2 on;
    return 301 https://neoqlick.com$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name neoqlick.com;
    http2 on;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
