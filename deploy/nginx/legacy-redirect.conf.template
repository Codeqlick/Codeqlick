# @OLD@ after the Neoqlick cut-over (architecture 4.18, decision 130): permanent redirects to the
# same path and query on @NEW@, kept for at least 12 months (until 2027-11-17) with the certificate
# so the redirect works over HTTPS. Written by deploy/neoqlick-cutover.sh, which keeps a dated copy
# of the site it replaces; `deploy/neoqlick-cutover.sh --rollback` puts that copy back.
#
# The redirect lives in `location /` (not at server level) so that certbot's renewal, which adds a
# /.well-known/acme-challenge location, still works.

server {
    listen 80;
    listen [::]:80;
    server_name @OLD@;

    location / {
        return 301 https://@NEW@$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @OLD@;

    ssl_certificate /etc/letsencrypt/live/@OLD@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@OLD@/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # A service worker script can't be a redirect: browsers refuse it. The old worker of this origin
    # is replaced by one that unregisters itself and clears its caches.
    location = /@APP@-sw.js {
        alias @SW_DIR@/legacy-sw-unregister.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
    }

    # A WebSocket client doesn't follow a redirect, and the old pages are gone, so nothing should
    # connect: answer Gone.
    location = /ws {
        return 410;
    }

    location / {
        return 301 https://@NEW@$request_uri;
    }
}
