# Umami's dashboard for Neoqlick's own website id (architecture 4.18): the same container as
# stats.codeqlick.com. Rendered by deploy/setup-neoqlick.sh. HTTP only on purpose: `certbot --nginx`
# adds the TLS listener and the redirect. Installed as
# /etc/nginx/sites-available/stats.neoqlick.com.conf.

server {
    listen 80;
    listen [::]:80;
    server_name stats.neoqlick.com;
    # HTTP/2 on the TLS listener certbot adds (nginx >= 1.25).
    http2 on;

    # Not for search engines.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://127.0.0.1:@UMAMI_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
