# @HOST@ (architecture 4.18, 6.3): the website app serves its pages; /ws is the app's WebSocket
# in the API (/v1/@APP@/ws). Rendered by deploy/setup-neoqlick.sh. HTTP only on purpose:
# `certbot --nginx` adds the TLS listener and the redirect. Installed as
# /etc/nginx/sites-available/@HOST@.conf.

# Named per app and per brand: map variables are global, and the old <app>.codeqlick.com sites
# still define their own.
map $http_upgrade $neoqlick_@APP@_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name @HOST@;
    # HTTP/2 on the TLS listener certbot adds (nginx >= 1.25).
    http2 on;

    client_max_body_size 1m;
#@UPLOAD@
    # Signaling and live WebSocket → API. Connections last long: keep the socket open; the API pings
    # every 30 s.
    location = /ws {
        proxy_pass http://127.0.0.1:@API_PORT@/v1/@APP@/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $neoqlick_@APP@_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
